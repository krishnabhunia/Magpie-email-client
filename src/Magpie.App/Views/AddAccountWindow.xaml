<Window x:Class="Magpie.App.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Magpie.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AddAccountViewModel}"
        Style="{StaticResource Window.Dialog}" Width="560" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Title="Magpie — Account">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="36" Height="36" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Serif}" FontSize="21" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SubHeading}" Style="{StaticResource Text.Caption}" Margin="0,8,0,6" />
            <!-- Design EX1: a fresh install is one step with a settings backup -->
            <Button Style="{StaticResource Button.Link}" Content="Have a settings backup? Restore everything from it" HorizontalAlignment="Left" Padding="0,2" Margin="0,0,0,14"
                    Click="OnRestoreBackup" Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}" />

            <TextBlock Text="Email address" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
            <TextBox x:Name="EmailBox" Style="{StaticResource TextBox.Field}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="OnEmailDone"
                     IsReadOnly="{Binding IsReauth}" Tag="you@example.com" />
            <TextBlock Text="Your name (shown to people you write to)" Style="{StaticResource Text.Caption}" Margin="0,12,0,5" Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}" />
            <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}" Tag="Krishna Bhunia" />

            <TextBlock Text="Account type" Style="{StaticResource Text.Caption}" Margin="0,12,0,5" Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding Choice, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label"
                      Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}" />

            <!-- Downloading (design DS1) -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsReauth, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="Download emails from the last" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding DownloadChoices}" DisplayMemberPath="Label" SelectedValuePath="Days"
                          SelectedValue="{Binding SyncDays, Mode=TwoWay}" />
                <TextBlock Text="Attachments" Style="{StaticResource Text.Caption}" Margin="0,10,0,5" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="AddAttachments" Content="Only when I open the email" IsChecked="{Binding DownloadAttachments, Mode=TwoWay, Converter={StaticResource InvBool}}" />
                    <RadioButton GroupName="AddAttachments" Content="Download them too" IsChecked="{Binding DownloadAttachments, Mode=TwoWay}" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Older emails are still listed and download when you open them. You can change this later in Settings → Accounts." />
            </StackPanel>

            <!-- Google -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding ShowGoogle, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Google account" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12" Text="Sign in on Google's page in your browser. Magpie never sees your Google password." />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Content="Sign in with Google" Command="{Binding SignInCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InvBool}}" />
                        <Button Style="{StaticResource Button.Link}" Content="Use an app password instead" Margin="14,0,0,0" Command="{Binding UseAppPasswordInsteadCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Margin="0,10,0,0" Visibility="{Binding GoogleReady, Converter={StaticResource InvBoolToVis}}"
                               Text="Google sign-in needs your own client ID first (Settings → Accounts → Sign-in apps, steps in SIGN-IN-SETUP.md). An app password works right away." />
                </StackPanel>
            </Border>

            <!-- Microsoft -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding ShowMicrosoft, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Microsoft account" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12" Text="Outlook.com and Microsoft 365 only allow sign-in through Microsoft's page (no passwords in mail apps)." />
                    <Button Style="{StaticResource Button.Primary}" Content="Sign in with Microsoft" HorizontalAlignment="Left" Command="{Binding SignInCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InvBool}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Margin="0,10,0,0" Visibility="{Binding MicrosoftReady, Converter={StaticResource InvBoolToVis}}"
                               Text="Microsoft sign-in needs your own client ID first (Settings → Accounts → Sign-in apps, steps in SIGN-IN-SETUP.md)." />
                </StackPanel>
            </Border>

            <!-- Password -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                <PasswordBox x:Name="PwdBox" Style="{StaticResource PasswordBox.Field}" PasswordChanged="OnPasswordChanged" />
                <Button Style="{StaticResource Button.Link}" Content="Server settings" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ToggleAdvancedCommand}" />
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Incoming" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}" Tag="imap.example.com" Margin="0,0,0,8" />
                        <TextBox Grid.Column="3" Style="{StaticResource TextBox.Field}" Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <ComboBox Grid.Column="5" ItemsSource="{Binding SecurityChoices}" SelectedValue="{Binding ImapSecurity, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="Outgoing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" Tag="smtp.example.com" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBox.Field}" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding SecurityChoices}" SelectedValue="{Binding SmtpSecurity, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="User name" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource TextBox.Field}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Tag="Usually your email address" />
                    </Grid>
                </Border>
                <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding AddWithPasswordCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InvBool}}">
                    <TextBlock Text="Check and continue" />
                </Button>
            </StackPanel>

            <!-- Progress / errors -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="90" Height="3" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Link}" Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                       Visibility="{Binding Busy, Converter={StaticResource InvBoolToVis}}" />
            <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" FontSize="12.5" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource Button.Secondary}" Content="Close" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
