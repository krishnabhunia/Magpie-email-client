<Window x:Class="Magpie.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Magpie.App.ViewModels"
        xmlns:set="clr-namespace:Magpie.Core.Settings;assembly=Magpie.Core"
        xmlns:svc="clr-namespace:Magpie.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Magpie — Settings" Width="1040" Height="800" MinWidth="820" MinHeight="560"
        Style="{StaticResource Window.Magpie}" Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Disabled section look (S1): faded, not clickable -->
        <Style x:Key="Section.Dim" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Nav.Settings" TargetType="RadioButton" BasedOn="{StaticResource Button.Folder}">
            <Setter Property="GroupName" Value="SettingsNav" />
            <Setter Property="Height" Value="38" />
        </Style>
        <Style x:Key="FeatureRow" TargetType="Border">
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Brush.Sidebar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,12">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="20,0,0,0" />
                <!-- Search in Settings (design SS1): every setting by its name or plain words; Ctrl+F jumps here, Esc clears -->
                <Border DockPanel.Dock="Top" Margin="10,0,10,10" Height="34" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Brush.Card.Background}">
                    <DockPanel Margin="9,0,6,0">
                        <svc:IconChip DockPanel.Dock="Left" Icon="search" Size="15" Plain="True" Stroke="{DynamicResource Brush.Accent.Text}" Margin="0,0,7,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" MinHeight="22" Width="22" Padding="0" ToolTip="Clear (Esc)"
                                Click="OnSearchClear" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                        <TextBox x:Name="SettingsSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" Padding="0" PreviewKeyDown="OnSearchKey" AutomationProperties.Name="Search settings" ToolTip="Search settings (Ctrl+F)" />
                    </DockPanel>
                </Border>
                <StackPanel>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="General"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=General}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="general" Size="24" Margin="0,0,10,0" /><TextBlock Text="General" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsGeneral, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsGeneral}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Accounts"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Accounts}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="accounts" Size="24" Margin="0,0,10,0" /><TextBlock Text="Accounts" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsAccounts, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsAccounts}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="AI"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=AI}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="summarise" Size="24" Margin="0,0,10,0" /><TextBlock Text="AI features" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsAI, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsAI}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Rules"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Rules}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="rules" Size="24" Margin="0,0,10,0" /><TextBlock Text="Rules" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsRules, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsRules}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Signatures"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Signatures}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="signature" Size="24" Margin="0,0,10,0" /><TextBlock Text="Signatures &amp; replies" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsSignatures, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsSignatures}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Toolbar"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Toolbar}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="toolbar" Size="24" Margin="0,0,10,0" /><TextBlock Text="Appearance" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsToolbar, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsToolbar}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Notifications"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Notifications}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="notifications" Size="24" Margin="0,0,10,0" /><TextBlock Text="Notifications" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsNotifications, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsNotifications}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Templates"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Templates}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="templates" Size="24" Margin="0,0,10,0" /><TextBlock Text="Templates" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsTemplates, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsTemplates}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Keys"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Keys}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="keys" Size="24" Margin="0,0,10,0" /><TextBlock Text="Keyboard shortcuts" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsKeys, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsKeys}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="Updates"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Updates}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="update" Size="24" Margin="0,0,10,0" /><TextBlock Text="Updates" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsUpdates, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsUpdates}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Settings}" Command="{Binding GoCommand}" CommandParameter="About"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal"><svc:IconChip Icon="about" Size="24" Margin="0,0,10,0" /><TextBlock Text="About" VerticalAlignment="Center" /><Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HitsAbout, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding HitsAbout}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" FontWeight="Bold" /></Border></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Save bar -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="36,12" Background="{DynamicResource Brush.Window.Background}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Apply" Margin="0,0,8,0" Click="OnApply" ToolTip="Save the changes and keep Settings open" />
                        <Button Style="{StaticResource Button.Primary}" Content="Save and close" Padding="24,7" Click="OnSave" />
                    </StackPanel>
                    <TextBlock x:Name="AppliedNote" Text="✓ Saved" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Visibility="Collapsed" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PagesScroll" VerticalScrollBarVisibility="Auto">
                <Grid Margin="40,30,40,30" MaxWidth="780" HorizontalAlignment="Left">

                    <!-- ═══════════ Search results (design SS1) ═══════════ -->
                    <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SearchHeading}" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="{Binding SearchSub}" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
                        <ItemsControl ItemsSource="{Binding SearchHits}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingHit}">
                                    <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="14,10" FontWeight="Normal"
                                            Command="{Binding DataContext.GoToHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <svc:IconChip DockPanel.Dock="Left" Icon="{Binding IconKey}" Size="28" Margin="0,0,12,0" />
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Accent.Text}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Run Text="{Binding PageLabel, Mode=OneWay}" /><Run Text=" →" />
                                            </TextBlock>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">

                    <!-- ═══════════ General ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=General}">
                        <TextBlock Text="General" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="How Magpie shows and handles your mail." Style="{StaticResource Text.Caption}" Margin="0,4,0,20" />

                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Border x:Name="RowSmartInbox" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SmartInbox, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Smart inbox" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Split the inbox into People, Notifications and Newsletters. Decided on this PC from mail headers — nothing is sent anywhere." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowMarkRead" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding MarkReadOnOpen, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Mark as read when opened" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Otherwise conversations stay unread until you mark them." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowImages" Style="{StaticResource FeatureRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="200" SelectedValue="{Binding RemoteImages, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Ask (block by default)" Tag="{x:Static set:RemoteImages.Ask}" />
                                            <ComboBoxItem Content="Always load" Tag="{x:Static set:RemoteImages.Always}" />
                                            <ComboBoxItem Content="Never load" Tag="{x:Static set:RemoteImages.Never}" />
                                        </ComboBox>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Pictures from the internet" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Blocking them stops senders tracking when you open mail." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="RowUndo" Style="{StaticResource FeatureRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding UndoChoices}" SelectedItem="{Binding UndoSendSeconds, Mode=TwoWay}" ItemStringFormat="{}{0} seconds" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Undo send" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="How long you can take a message back after pressing Send." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="RowInterval" Style="{StaticResource FeatureRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SyncIntervalMinutes, Mode=TwoWay}" ItemStringFormat="{}{0} min" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Check all folders every" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="New mail in the Inbox arrives instantly (push) when the server supports it." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="RowTray" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Keep running in the notification area when closed" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Needed for new-mail alerts, send later, snooze and reminders." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowStartup" Style="{StaticResource FeatureRow}" BorderThickness="0">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Start with Windows" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Starts quietly in the notification area when you sign in." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Gatekeeper (design B7) -->
                        <TextBlock Text="GATEKEEPER" Style="{StaticResource Text.SectionCaps}" Margin="0,26,0,10" />
                        <Border x:Name="RowGatekeeper" Style="{StaticResource Card}" Padding="22,6">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureRow}" BorderThickness="0">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Gatekeeper, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Gatekeeper: new senders wait at the door" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Mail from someone you've never written to or heard from waits outside the Inbox until you Allow or Block them. Switching it off lets everyone waiting in." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <StackPanel Margin="0,4,0,10" Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Blocked — their mail goes to Spam" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Blocked}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Unblock" Padding="4,0" MinHeight="20"
                                                            Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TAGS" Style="{StaticResource Text.SectionCaps}" Margin="0,26,0,10" />
                        <Border x:Name="RowTags" Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EditableTag}">
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="Remove tag"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0" SelectedItem="{Binding Color, Mode=TwoWay}"
                                                          ItemsSource="{Binding DataContext.ColorChoices, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="10" Height="10" Fill="{Binding Converter={StaticResource HexBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}" FontSize="12" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Button.Secondary}" Content="Add tag" HorizontalAlignment="Left" FontWeight="Normal" Command="{Binding AddTagCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Design EX1 -->
                        <TextBlock Text="BACKUP" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,10" />
                        <Border x:Name="RowBackup" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Back up your settings" FontWeight="Medium" FontSize="13.5" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="One file with everything you set up in Magpie: accounts and their sign-ins, rules, signatures, quick replies, templates, tags, Gatekeeper lists, look and layout. Restore it after reinstalling Magpie or on another PC, and you're back where you were. The file is locked with a password you choose." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Primary}" Content="Save a backup…" Click="OnBackupSave" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Restore from a backup…" Click="OnBackupRestore" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Design DL1 -->
                        <TextBlock Text="WHERE YOUR MAIL IS KEPT" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,10" />
                        <Border x:Name="RowMailFolder" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Your downloaded emails, attachments you opened, drafts waiting on this PC, snoozes and reminders. Keep them on another drive (an encrypted one, if you like) and they stay there when Magpie is uninstalled." />
                                <Border Background="{DynamicResource Brush.Window.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Move…" Click="OnMailMove" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Open folder" Click="OnMailOpen" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding MailFolderPath}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MailFolderInfo}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Settings and sign-ins stay in your Windows profile: Magpie needs them to find this folder. They're small, and a backup covers them." />
                                <!-- Design DL1, encryption option A (approved 29 Sep 2026): the drive does it -->
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="To keep your mail encrypted, choose a folder on a BitLocker or VeraCrypt drive. Magpie waits for you to unlock it when it starts." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ Accounts ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Accounts}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Add account" Click="OnAddAccount" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Accounts" Style="{StaticResource Text.Serif}" FontSize="21" />
                                <TextBlock Text="Gmail, Outlook / Microsoft 365 and any IMAP mailbox." Style="{StaticResource Text.Caption}" Margin="0,4,0,20" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="RowAccounts" ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EditableAccount}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource Button.Secondary}" Content="Sign in again" FontWeight="Normal" Margin="0,0,8,0" Click="OnReauth" Tag="{Binding}" />
                                                    <Button Style="{StaticResource Button.Secondary}" Content="Remove" FontWeight="Normal" Foreground="{DynamicResource Brush.Danger}"
                                                            Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Color, Converter={StaticResource HexBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Email}" FontWeight="SemiBold" FontSize="14" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="18,2,0,0" />
                                                    <TextBlock Text="{Binding Servers}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="18,0,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Your name" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                                <TextBlock Grid.Row="1" Text="Signature" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Button.Link}" Content="Edit in Signatures &amp; replies →" HorizontalAlignment="Left" Padding="0,2" Margin="0,0,0,8"
                                                        Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Signatures" />
                                                <TextBlock Grid.Row="2" Text="Colour" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" SelectedItem="{Binding Color, Mode=TwoWay}" Margin="0,0,0,8"
                                                          ItemsSource="{Binding DataContext.ColorChoices, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="10" Height="10" Fill="{Binding Converter={StaticResource HexBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}" FontSize="12" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <CheckBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Left">
                                                    <TextBlock Text="Sync this account" />
                                                </CheckBox>
                                                <!-- Design DS1 -->
                                                <TextBlock Grid.Row="4" Text="Download emails" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Text="from the last" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox Width="140" ItemsSource="{Binding DownloadChoices}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding SyncDays, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="5" Text="Attachments" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,10,0,0" />
                                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,10,0,0">
                                                    <RadioButton GroupName="{Binding Email}" Content="Only when I open the email" IsChecked="{Binding DownloadAttachments, Mode=TwoWay, Converter={StaticResource InvBool}}" />
                                                    <RadioButton GroupName="{Binding Email}" Content="Download them too" IsChecked="{Binding DownloadAttachments, Mode=TwoWay}" Margin="0,4,0,0" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="Older emails are still listed and download when you open them. A longer time fetches the older emails in the background; a shorter one keeps what is already downloaded." />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="SIGN-IN APPS (FOR GOOGLE AND MICROSOFT SIGN-IN)" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,10" />
                        <Border x:Name="RowSignIn" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12"
                                           Text="Signing in with Google or Microsoft needs your own free app registration (5 minutes, once). The steps are in SIGN-IN-SETUP.md next to Magpie.exe. Without it you can still add Gmail with an app password, and any IMAP account with its password." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Google client ID" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Tag="….apps.googleusercontent.com" />
                                    <TextBlock Grid.Row="1" Text="Google client secret" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding GoogleClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Tag="GOCSPX-…" />
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Import Google client JSON…" FontWeight="Normal" HorizontalAlignment="Left" Margin="0,0,0,14" Click="OnImportGoogle" />
                                    <TextBlock Grid.Row="3" Text="Microsoft client ID" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" Tag="Application (client) ID from Azure" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ AI features (S1 / S2 / S3) ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=AI}">
                        <TextBlock Text="AI features" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="Connect an AI provider and choose which features use it. Mail works normally whether this is on or off." Style="{StaticResource Text.Caption}" Margin="0,4,0,20" />

                        <!-- Quick setup presets (design Q1): Off · A · B · C · Custom -->
                        <Border x:Name="RowAiPresets" Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,14">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Quick setup" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Pick an option to set the switches below. Change any switch yourself and it becomes Custom." Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Preset}" Margin="0,0,8,0" Padding="12,9" HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                                    ToolTip="{Binding Description}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.85" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PresetSummary}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Master switch -->
                        <Border x:Name="RowAiMaster" Style="{StaticResource Card}" Padding="22,18">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AiEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Enable AI features" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="When off, no data is sent to any model and all AI controls are hidden from the interface." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Provider -->
                        <StackPanel x:Name="RowAiProvider" Style="{StaticResource Section.Dim}" IsEnabled="{Binding AiEnabled}" Margin="0,20,0,0">
                            <TextBlock Text="AI CONNECTIONS" Style="{StaticResource Text.SectionCaps}" />
                            <!-- Design AI2: several connections; one is in use; each can be edited, tested and deleted -->
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding AiConnections}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AiConnectionItem}">
                                                <Border x:Name="Row" Padding="16,10" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource Button.Link}" Content="Edit" Margin="0,0,12,0"
                                                                    Command="{Binding DataContext.EditAiConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource Button.Link}" Content="Delete" Foreground="{DynamicResource Brush.Danger}"
                                                                    Command="{Binding DataContext.DeleteAiConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <RadioButton GroupName="AiInUse" IsChecked="{Binding IsActive, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Use this one"
                                                                     Command="{Binding DataContext.UseAiConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                                <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="8" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="In use" Foreground="{DynamicResource Brush.Success}" FontSize="11.5" FontWeight="Medium" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" />
                                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Visibility="{Binding Status, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Button.Link}" Content="+ Add an AI connection" HorizontalAlignment="Left" Margin="16,10" Command="{Binding AddAiConnectionCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="Name" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding SelectedAiConnection.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                                    <TextBlock Text="Provider" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding Providers}" SelectedValue="{Binding Provider, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,0,0,14" />
                                    <TextBlock Text="Endpoint" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,5">
                                                <Run Text="API key " /><Run Text="{Binding KeyHint, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            </TextBlock>
                                            <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource PasswordBox.Field}" PasswordChanged="OnApiKeyChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Model" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                                            <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource Button.Secondary}" Content="Test connection" FontWeight="Normal" Command="{Binding TestConnectionCommand}" />
                                        <TextBlock Text="{Binding TestStatus}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="440"
                                                   Foreground="{Binding TestOk, Converter={StaticResource BoolToBrush}, ConverterParameter=Brush.Success|Brush.Text.Secondary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Features -->
                        <StackPanel x:Name="RowAiFeatures" Style="{StaticResource Section.Dim}" IsEnabled="{Binding AiEnabled}" Margin="0,20,0,0">
                            <TextBlock Text="FEATURES" Style="{StaticResource Text.SectionCaps}" />
                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource FeatureRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Summarise}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Tint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Summarise, Mode=TwoWay}" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Teal}" Margin="0,0,14,0">
                                                <TextBlock Text="Option B" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Text}" />
                                            </Border>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Summarise thread" FontWeight="Medium" FontSize="13.5" />
                                                <TextBlock Text="Adds a &quot;Summarise&quot; button to the thread toolbar. Sends thread text to the model." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource FeatureRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Draft}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Ai.Tint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle.Ai}" IsChecked="{Binding Draft, Mode=TwoWay}" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Indigo}" Margin="0,0,14,0">
                                                <TextBlock Text="Option C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" />
                                            </Border>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Write draft from prompt" FontWeight="Medium" FontSize="13.5" />
                                                <TextBlock Text="Opens the assistant panel in Compose. Sends your prompt and thread context to the model." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource FeatureRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rewrite}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Ai.Tint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle.Ai}" IsChecked="{Binding Rewrite, Mode=TwoWay}" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Indigo}" Margin="0,0,14,0">
                                                <TextBlock Text="Option C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" />
                                            </Border>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Rewrite selection" FontWeight="Medium" FontSize="13.5" />
                                                <TextBlock Text="Shows rewrite chips when text is selected in Compose. Sends selected text to the model." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource FeatureRow}">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Replies}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Ai.Tint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle.Ai}" IsChecked="{Binding Replies, Mode=TwoWay}" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Indigo}" Margin="0,0,14,0">
                                                <TextBlock Text="Option C" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" />
                                            </Border>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="Suggested replies" FontWeight="Medium" FontSize="13.5" />
                                                <TextBlock Text="Shows reply chips below a thread. Sends thread text to the model when you open it." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notes -->
                        <Border Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,20,0,0">
                            <Grid>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ai.Text}" FontSize="12.5"
                                           Text="Turn &quot;Enable AI features&quot; on above to configure the provider and choose features. Nothing is sent to any model while it is off."
                                           Visibility="{Binding AiEnabled, Converter={StaticResource InvBoolToVis}}" />
                                <StackPanel Visibility="{Binding AiEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ai.Text}" FontSize="12.5"
                                               Text="Each feature asks for consent the first time it sends data to a cloud provider, and shows exactly what gets sent. Local models never ask — nothing leaves your PC. Results always appear as a card you accept; nothing is inserted or sent automatically." />
                                    <Button Style="{StaticResource Button.Link}" Content="Forget the permissions I gave" FontSize="12" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ForgetConsentsCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ Notifications ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Notifications}">
                        <TextBlock Text="Notifications" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="Alerts for new mail, reminders and snoozed conversations." Style="{StaticResource Text.Caption}" Margin="0,4,0,20" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Border x:Name="RowNotify" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Notifications, Mode=TwoWay}">
                                        <TextBlock Text="Show a notification for new mail" FontWeight="Medium" FontSize="13.5" />
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowNotifyPeople" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotifyPeopleOnly, Mode=TwoWay}" IsEnabled="{Binding Notifications}">
                                        <StackPanel>
                                            <TextBlock Text="Only for mail from people" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Stay quiet for newsletters, receipts and automatic notifications." Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowNotifySound" Style="{StaticResource FeatureRow}">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotificationSound, Mode=TwoWay}" IsEnabled="{Binding Notifications}">
                                        <TextBlock Text="Play a sound" FontWeight="Medium" FontSize="13.5" />
                                    </CheckBox>
                                </Border>
                                <Border x:Name="RowNotifyTest" Style="{StaticResource FeatureRow}" BorderThickness="0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Send a test notification" Click="OnTestNotification" VerticalAlignment="Center" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Try it" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="Shows a sample new-mail notification now, with the sound if it's on (the settings on this page, even before you save)." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ Templates ═══════════ -->
                    <!-- ═══════════ Rules (design B5) ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Rules}">
                        <TextBlock Text="Rules" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="Rules sort new mail as it arrives: they run top to bottom, on this PC, before you are notified. A message a rule moves or deletes isn't seen by the rules below it."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Style="{StaticResource Button.Chip}" GroupName="RulesTab" Content="{Binding FiltersTabLabel}" Margin="0,0,6,0" Padding="14,4"
                                         IsChecked="{Binding IsFiltersTab, Mode=OneWay}" Command="{Binding ShowRulesTabCommand}" CommandParameter="Filters" />
                            <RadioButton x:Name="RowAutoDelete" Style="{StaticResource Button.Chip}" GroupName="RulesTab" Content="{Binding AutoDeleteTabLabel}" Padding="14,4"
                                         IsChecked="{Binding IsAutoDeleteTab, Mode=OneWay}" Command="{Binding ShowRulesTabCommand}" CommandParameter="AutoDelete" />
                        </StackPanel>

                        <!-- Auto-delete rules (design AD4) -->
                        <StackPanel Visibility="{Binding IsAutoDeleteTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Emails from these senders go to Trash on their own, a set time after they arrive. Pinned emails are never deleted. Paused rules delete nothing until you resume them." />
                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="14,9,10,7" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="64" /><ColumnDefinition Width="96" /><ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FROM" />
                                        <TextBlock Grid.Column="1" Text="DELETE AFTER" />
                                        <TextBlock Grid.Column="2" Text="ACCOUNTS" />
                                        <TextBlock Grid.Column="3" Text="WAITING" />
                                        <TextBlock Grid.Column="4" Text="NEXT DELETE" />
                                    </Grid>
                                    <TextBlock Text="No auto-delete rules yet. Use Delete ▾ on an email, or New rule." Style="{StaticResource Text.Caption}" Margin="14,4,14,12"
                                               Visibility="{Binding AutoDeleteList.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />
                                    <ItemsControl ItemsSource="{Binding AutoDeleteList}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AutoDeleteRow}">
                                                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,6,10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="64" /><ColumnDefinition Width="96" /><ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding From}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding Paused, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding After}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Accounts}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Waiting}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding NextDelete}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource Button.Link}" Content="Edit" Padding="4,0" MinHeight="22"
                                                                    Command="{Binding DataContext.EditAutoDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource Button.Link}" Content="{Binding PauseLabel}" Padding="4,0" MinHeight="22"
                                                                    Command="{Binding DataContext.PauseAutoDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource Button.Link}" Content="Remove" Foreground="{DynamicResource Brush.Danger}" Padding="4,0" MinHeight="22"
                                                                    Command="{Binding DataContext.RemoveAutoDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Button.Secondary}" Content="New rule" HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Normal" Command="{Binding NewAutoDeleteCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFiltersTab, Converter={StaticResource BoolToVis}}">
                        <Grid x:Name="RowRules">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Rule list -->
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <TextBlock Text="No rules yet." Style="{StaticResource Text.Caption}" Margin="14,12" Visibility="{Binding RuleList.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />
                                        <ItemsControl ItemsSource="{Binding RuleList}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EditableRule}">
                                                    <Border x:Name="Item" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="10,8,8,8" Background="Transparent" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,8,0"
                                                                      Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                      ToolTip="On / off" AutomationProperties.Name="{Binding DisplayName}" />
                                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                                                <Button Style="{StaticResource Button.Icon}" Content="&#xE70E;" FontSize="9" MinHeight="18" Width="20" Padding="0" ToolTip="Move up (runs earlier)"
                                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource Button.Icon}" Content="&#xE70D;" FontSize="9" MinHeight="18" Width="20" Padding="0" ToolTip="Move down (runs later)"
                                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Row.Selected}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource Button.Secondary}" Content="New rule" HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Normal" Command="{Binding NewRuleCommand}" />
                            </StackPanel>

                            <!-- Editor -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasSelectedRule, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding SelectedRule}">
                                    <TextBlock Text="Rule name" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                    <WrapPanel Margin="0,16,0,8">
                                        <TextBlock Text="WHEN A MESSAGE ARRIVES IN" Style="{StaticResource Text.SectionCaps}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="150" ItemsSource="{Binding DataContext.RuleAccountChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AccountId, Mode=TwoWay}" Margin="0,0,8,0" />
                                        <TextBlock Text="AND" Style="{StaticResource Text.SectionCaps}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="64" ItemsSource="{Binding DataContext.MatchChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MatchAll, Mode=TwoWay}" Margin="0,0,8,0" />
                                        <TextBlock Text="OF THESE MATCH" Style="{StaticResource Text.SectionCaps}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Conditions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EditableCondition}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="128" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{x:Static vm:EditableCondition.FieldChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding Field, Mode=TwoWay}" AutomationProperties.Name="Field" />
                                                    <ComboBox Grid.Column="1" MinWidth="118" Margin="6,0,0,0" ItemsSource="{Binding OpChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding Op, Mode=TwoWay}" Visibility="{Binding ShowOp, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Operator" />
                                                    <TextBox Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource TextBox.Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Value" />
                                                    <ComboBox Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding ValueChoices}" SelectedItem="{Binding Value, Mode=TwoWay}"
                                                              Visibility="{Binding ShowChoice, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Value" />
                                                    <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Margin="4,0,0,0" ToolTip="Remove condition"
                                                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Button.Link}" Content="+ Add condition" HorizontalAlignment="Left" Padding="0,2"
                                            Command="{Binding DataContext.AddConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                    <TextBlock Text="THEN" Style="{StaticResource Text.SectionCaps}" Margin="0,16,0,8" />
                                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EditableAction}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{x:Static vm:EditableAction.KindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding Kind, Mode=TwoWay}" AutomationProperties.Name="Action" />
                                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding Target, Mode=TwoWay}"
                                                              Visibility="{Binding ShowTarget, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Target" />
                                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Margin="4,0,0,0" ToolTip="Remove action"
                                                            Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Button.Link}" Content="+ Add action" HorizontalAlignment="Left" Padding="0,2"
                                            Command="{Binding DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel>
                                            <CheckBox Content="{Binding ApplyToExistingLabel}" IsChecked="{Binding ApplyToExisting, Mode=TwoWay}" />
                                            <DockPanel Margin="0,12,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Save rule" Padding="18,6" Command="{Binding SaveRuleCommand}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Preview matches" FontWeight="Normal" Margin="0,0,8,0" Command="{Binding PreviewRuleCommand}" />
                                                <Button Style="{StaticResource Button.Link}" Content="Delete rule" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Left" Padding="0,2"
                                                        Command="{Binding DeleteRuleCommand}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding RuleStatus}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                                                       Foreground="{Binding RuleStatusIsError, Converter={StaticResource BoolToBrush}, ConverterParameter=Brush.Danger|Brush.Success}" />
                                            <TextBlock Text="{Binding RulePreviewTitle}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <ItemsControl ItemsSource="{Binding RulePreview}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RuleMatchLine}">
                                                        <DockPanel Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                                            <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Subject, Mode=OneWay}" /></TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="Body looks at the start of each message — the part Magpie gets with new mail — and the whole text of messages you've opened." />
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══════════ Signatures & replies (design B6) ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Signatures}">
                        <TextBlock Text="Signatures &amp; replies" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="A signature for each account, and short replies you can send with one click." Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />

                        <TextBlock Text="SIGNATURES" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,10" />
                        <Border x:Name="RowSignatures" Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EditableAccount}">
                                            <RadioButton Style="{StaticResource Button.Chip}" GroupName="SigAccount" Content="{Binding Email}" Margin="0,0,6,6" FontSize="12.5" Padding="12,4"
                                                         IsChecked="{Binding IsSignatureSelected, Mode=OneWay}"
                                                         Command="{Binding DataContext.PickSignatureAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Add an account first." Style="{StaticResource Text.Caption}" Visibility="{Binding Accounts.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />

                                <StackPanel Visibility="{Binding SignatureAccount, Converter={StaticResource BoolToVis}}">
                                    <!-- Design B6, fixed 29 Sep 2026: a preview here; the signature is written in its own window
                                         (SignatureEditorWindow, a normal WebView2 like the compose window) -->
                                    <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" MinHeight="70"
                                            Background="{DynamicResource Brush.Card.Background}">
                                        <Grid>
                                            <TextBlock Text="{Binding SignatureAccount.SignaturePlain}" TextWrapping="Wrap" />
                                            <TextBlock Text="No signature yet." Style="{StaticResource Text.Caption}"
                                                       Visibility="{Binding SignatureAccount.HasSignature, Converter={StaticResource InvBoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Has a picture (a logo)." Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding SignatureAccount.HasSignaturePicture, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Content="Edit signature…" Click="OnEditSignature" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Get my Gmail signature" Margin="8,0,0,0" Command="{Binding ImportGmailSignatureCommand}"
                                                Visibility="{Binding SignatureAccount.CanImportGmailSignature, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Copies the signature set in Gmail (Settings → Signature) for this address" />
                                        <TextBlock Text="{Binding SignatureStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" />
                                    </StackPanel>
                                    <CheckBox Content="Add to new messages" IsChecked="{Binding SignatureAccount.SignatureOnNew, Mode=TwoWay}" Margin="0,12,0,4" />
                                    <CheckBox Content="Add to replies and forwards (above the quoted text)" IsChecked="{Binding SignatureAccount.SignatureOnReplies, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Pictures are sent inside the email, so they show even when the other person blocks pictures from the internet. Changes apply when you press Save." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="QUICK REPLIES" Style="{StaticResource Text.SectionCaps}" Margin="0,26,0,10" />
                        <Border x:Name="RowQuickReplies" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="They show under a conversation. One click sends the reply straight away — with the usual Undo." />
                                <ItemsControl ItemsSource="{Binding QuickReplyList}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EditableQuickReply}">
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="Remove" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.RemoveQuickReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quick reply" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Button.Secondary}" Content="Add quick reply" HorizontalAlignment="Left" FontWeight="Normal" Margin="0,4,0,0" Command="{Binding AddQuickReplyCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Templates}">
                        <TextBlock Text="Templates" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="Text you insert often. Use them from the Templates button in a new message." Style="{StaticResource Text.Caption}" Margin="0,4,0,20" />
                        <ItemsControl x:Name="RowTemplates" ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EditableTemplate}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="Remove template"
                                                        Command="{Binding DataContext.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="Medium" Margin="0,0,8,0" />
                                            </DockPanel>
                                            <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="70" VerticalContentAlignment="Top" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Button.Secondary}" Content="Add template" HorizontalAlignment="Left" FontWeight="Normal" Command="{Binding AddTemplateCommand}" />
                    </StackPanel>

                    <!-- ═══════════ Keyboard ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Keys}">
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.Serif}" FontSize="21" Margin="0,0,0,20" />
                        <Border x:Name="RowKeys" Style="{StaticResource Card}">
                            <Grid x:Name="KeysGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ Toolbar & buttons (design C3) ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Toolbar}">
                        <TextBlock Text="Appearance" Style="{StaticResource Text.Serif}" FontSize="21" />
                        <TextBlock Text="Light or dark, and which buttons sit above a conversation, their order and how they look. Hidden ones stay in ··· More." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Theme (design B1) -->
                        <TextBlock Text="THEME" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,10" />
                        <Border x:Name="RowTheme" Style="{StaticResource Card}" Margin="0,0,0,22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Theme" Margin="0,0,26,0" Command="{Binding SetThemeCommand}" CommandParameter="MatchWindows"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=MatchWindows}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="20" CornerRadius="4" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Border Background="#F7F6F2" CornerRadius="3,0,0,3" /><Border Grid.Column="1" Background="#111417" CornerRadius="0,3,3,0" /></Grid>
                                            </Border>
                                            <TextBlock Text="Match Windows" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Theme" Margin="0,0,26,0" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Light}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="20" CornerRadius="4" Background="#F7F6F2" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" Margin="0,0,8,0" />
                                            <TextBlock Text="Light" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Theme" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                                 IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Dark}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="20" CornerRadius="4" Background="#111417" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" Margin="0,0,8,0" />
                                            <TextBlock Text="Dark" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <TextBlock Text="{Binding MatchWindowsNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="Emails that bring their own colours keep them, on a white card, so they stay readable in the dark." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TOOLBAR &amp; BUTTONS" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,10" />

                        <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                        <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="10" Padding="10,8,4,4" Background="{DynamicResource Brush.Window.Background}">
                            <ItemsControl ItemsSource="{Binding ToolbarPreview}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolbarButtonVm}">
                                        <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource Brush.Control.Background}"
                                                Padding="6,4,10,4" Margin="0,0,6,4" ToolTip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <svc:IconChip Icon="{Binding IconKey}" Size="22" Mono="{Binding DataContext.Colourful, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBool}}"
                                                              Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RowToolbar" Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="14,9,10,7" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Show" />
                                        <TextBlock Grid.Column="1" Text="Button" />
                                        <TextBlock Grid.Column="2" Text="Key" />
                                        <TextBlock Grid.Column="3" Text="Order" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ToolbarRows}" AlternationCount="2" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EditableToolbarButton}">
                                                <Border x:Name="Row" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,5,10,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="76" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShowLabel}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <svc:IconChip Icon="{Binding IconKey}" Size="24" Mono="{Binding DataContext.Colourful, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBool}}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource Button.Secondary}" Content="↑" Width="30" MinHeight="26" Padding="0" Margin="0,0,4,0" FontWeight="Normal"
                                                                    Command="{Binding DataContext.MoveToolbarUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding UpLabel}" ToolTip="{Binding UpLabel}" />
                                                            <Button Style="{StaticResource Button.Secondary}" Content="↓" Width="30" MinHeight="26" Padding="0" FontWeight="Normal"
                                                                    Command="{Binding DataContext.MoveToolbarDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding DownLabel}" ToolTip="{Binding DownLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Row.Alt}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border x:Name="RowButtonStyle" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Button style" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <RadioButton GroupName="BtnStyle" Content="Icon + name" Margin="0,3"
                                                     IsChecked="{Binding ButtonStyle, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=IconAndName}"
                                                     Command="{Binding SetButtonStyleCommand}" CommandParameter="IconAndName" />
                                        <RadioButton GroupName="BtnStyle" Content="Icon only (name shows on hover)" Margin="0,3"
                                                     IsChecked="{Binding ButtonStyle, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=IconOnly}"
                                                     Command="{Binding SetButtonStyleCommand}" CommandParameter="IconOnly" />
                                        <RadioButton GroupName="BtnStyle" Content="Name only" Margin="0,3"
                                                     IsChecked="{Binding ButtonStyle, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=NameOnly}"
                                                     Command="{Binding SetButtonStyleCommand}" CommandParameter="NameOnly" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RowLook" Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Look" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <CheckBox Content="Colourful icons" IsChecked="{Binding Colourful, Mode=TwoWay}" Margin="0,3" />
                                        <CheckBox Content="Same order in the list's right-click menu" IsChecked="{Binding MenuFollowsToolbar, Mode=TwoWay}" Margin="0,3" />
                                        <CheckBox Content="Show the status bar" IsChecked="{Binding ShowStatusBar, Mode=TwoWay}" Margin="0,3" />
                                        <TextBlock Text="Folder numbers" Margin="0,10,0,4" />
                                        <ComboBox ItemsSource="{Binding CountChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Counts, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource Button.Secondary}" Content="Reset to default" HorizontalAlignment="Left" Margin="0,12,0,0" FontWeight="Normal" Command="{Binding ResetToolbarCommand}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Reply and Summarise always stay on the right. Changes apply when you press Save." />
                            </StackPanel>
                        </Grid>

                        <!-- Folder details on hover (design H2) -->
                        <TextBlock Text="FOLDER DETAILS ON HOVER" Style="{StaticResource Text.SectionCaps}" Margin="0,26,0,10" />
                        <Border x:Name="RowHover" Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding HoverEnabled, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="Show details when I point at a folder" FontWeight="Medium" FontSize="13.5" />
                                        <TextBlock Text="A small card next to the folder: its numbers and what arrived last. The icon rail always shows the folder's name and numbers." Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </CheckBox>
                                <ItemsControl ItemsSource="{Binding HoverLines}" Margin="0,12,0,0" IsEnabled="{Binding HoverEnabled}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EditableHoverLine}">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding On, Mode=TwoWay}" Margin="0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding HoverEnabled}">
                                    <TextBlock Text="Appears after" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="110" ItemsSource="{Binding HoverDelayChoices}" SelectedItem="{Binding HoverDelay, Mode=TwoWay}" ItemStringFormat="{}{0} ms" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Buttons on email rows + multi-select (design H3) -->
                        <TextBlock Text="BUTTONS ON EMAIL ROWS" Style="{StaticResource Text.SectionCaps}" Margin="0,26,0,10" />
                        <Border x:Name="RowRowActions" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Up to five buttons on each conversation in the list, so you can act without opening it. Click a sender's initials to tick several conversations and act on all of them from the bar that appears." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                                        <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="10" Padding="12,8" Background="{DynamicResource Brush.Window.Background}" Margin="0,0,0,12">
                                            <DockPanel>
                                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding RowPreview}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ToolbarButtonVm}">
                                                            <Border Width="28" Height="28" CornerRadius="6" Margin="2,0,0,0" ToolTip="{Binding ToolTip}">
                                                                <svc:IconChip Icon="{Binding IconKey}" Size="22" Mono="{Binding DataContext.Colourful, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBool}}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#2563EB" Margin="0,0,10,0"><TextBlock Text="RS" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Rohan Shah" FontWeight="SemiBold" FontSize="12.5" />
                                                        <TextBlock Text="Flat visit on Saturday" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="8" Padding="0">
                                            <ItemsControl ItemsSource="{Binding RowActions}" AlternationCount="2" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:EditableRowAction}">
                                                        <Border x:Name="Row" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,4,8,4">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource Button.Secondary}" Content="↑" Width="28" MinHeight="24" Padding="0" Margin="0,0,4,0" FontWeight="Normal"
                                                                            Command="{Binding DataContext.MoveRowActionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding UpLabel}" ToolTip="{Binding UpLabel}" />
                                                                    <Button Style="{StaticResource Button.Secondary}" Content="↓" Width="28" MinHeight="24" Padding="0" FontWeight="Normal"
                                                                            Command="{Binding DataContext.MoveRowActionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding DownLabel}" ToolTip="{Binding DownLabel}" />
                                                                </StackPanel>
                                                                <CheckBox IsChecked="{Binding On, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}" />
                                                                <svc:IconChip Icon="{Binding IconKey}" Size="22" Margin="0,0,8,0" Mono="{Binding DataContext.Colourful, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBool}}" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                                            </DockPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Row.Alt}" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Text="{Binding RowLimitNote}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding RowLimitNote, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Show the buttons" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <RadioButton GroupName="RowMode" Content="On hover" Margin="0,3"
                                                     IsChecked="{Binding RowMode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=OnHover}"
                                                     Command="{Binding SetRowModeCommand}" CommandParameter="OnHover" />
                                        <RadioButton GroupName="RowMode" Content="Always" Margin="0,3"
                                                     IsChecked="{Binding RowMode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Always}"
                                                     Command="{Binding SetRowModeCommand}" CommandParameter="Always" />
                                        <RadioButton GroupName="RowMode" Content="Never" Margin="0,3"
                                                     IsChecked="{Binding RowMode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Never}"
                                                     Command="{Binding SetRowModeCommand}" CommandParameter="Never" />
                                        <TextBlock Text="Ask before deleting more than" Margin="0,14,0,4" />
                                        <ComboBox Width="120" HorizontalAlignment="Left" ItemsSource="{Binding ConfirmChoices}" SelectedItem="{Binding ConfirmDeleteOver, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="0 = never ask. Bulk archive, delete and move wait a few seconds with Undo in the bar." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ Updates (design U1) ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Updates}">
                        <StackPanel Orientation="Horizontal">
                            <svc:IconChip Icon="update" Size="44" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Updates" Style="{StaticResource Text.Serif}" FontSize="21" />
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="You have " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UpdateSource, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="RowUpdateCard" Style="{StaticResource Card}" Margin="0,18,0,0" DataContext="{Binding Updates}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource Brush.Success.Subtle}" CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Visibility="{Binding Badge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="8" Margin="0,10,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" />
                                        <Button Style="{StaticResource Button.Link}" Content="Full release notes on GitHub" HorizontalAlignment="Left" FontSize="12" Padding="0,4,0,0" MinHeight="20"
                                                Command="{Binding OpenReleasePageCommand}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource Button.Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Later" FontWeight="Normal" Command="{Binding LaterCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowLaterSkip, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Skip this version" FontWeight="Normal" Command="{Binding SkipCommand}"
                                            Visibility="{Binding ShowLaterSkip, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="RowUpdateSwitches" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock Text="Auto update" FontWeight="SemiBold" />
                                        <TextBlock Text="Checks at start and then once a day. A new version is downloaded, checked and installed in the background, and runs the next time you open Magpie." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Content="Include test versions (pre-releases)" IsChecked="{Binding IncludePrerelease, Mode=TwoWay}" Margin="0,3" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Each download is checked against the SHA-256 published with the release. Updating replaces only Magpie.exe — your mail, settings and sign-ins stay as they are — and the old version is kept as Magpie.previous.exe. If the new one fails to start, Magpie offers to go back to it." />
                        <TextBlock Text="{Binding PortableNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding IsPortable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- ═══════════ About ═══════════ -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/app-256.png" Width="48" Height="48" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Serif}" FontSize="21" />
                                <TextBlock Text="A local-first mail app for Windows." Style="{StaticResource Text.Caption}" />
                                <Button Style="{StaticResource Button.Link}" Content="Check for updates" HorizontalAlignment="Left" FontSize="12.5" Padding="0,2" MinHeight="20"
                                        Command="{Binding GoCommand}" CommandParameter="Updates" />
                            </StackPanel>
                        </StackPanel>
                        <!-- About Me (design A1): the same block as in Krishna's Android apps -->
                        <Border x:Name="RowAboutMe" Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <svc:IconChip Icon="accounts" Size="26" Margin="0,0,10,0" />
                                    <TextBlock Text="About Me" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding AuthorName}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Suggestion / Feedback / Bugs / Error" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
                                <Button x:Name="FeedbackLink" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Padding="0,2" MinHeight="22" Click="OnFeedbackEmail"
                                        ToolTip="Opens a new message in Magpie with the details filled in">
                                    <StackPanel Orientation="Horizontal">
                                        <svc:IconChip Icon="sent" Size="16" Plain="True" Stroke="{DynamicResource Brush.Accent.Text}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding FeedbackEmail}" FontSize="13.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Padding="0,2" MinHeight="22" Command="{Binding OpenLinkedInCommand}" Foreground="#0A66C2" ToolTip="Open in your browser">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="3" Background="#0A66C2" Margin="0,0,6,0"><TextBlock Text="in" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="{Binding LinkedIn}" FontSize="13.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Padding="0,2" MinHeight="22" Command="{Binding OpenFacebookCommand}" Foreground="#1877F2" ToolTip="Open in your browser">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="3" Background="#1877F2" Margin="0,0,6,0"><TextBlock Text="f" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="{Binding Facebook}" FontSize="13.5" />
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />
                                <TextBlock Text="{Binding VersionLine}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding ReleasedLine}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="RowData" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Your mail, settings and sign-ins are stored only on this PC. Passwords, tokens and API keys are encrypted with your Windows account (DPAPI)." />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0">
                                    <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Button.Secondary}" Content="Open data folder" FontWeight="Normal" Margin="0,0,8,0" Command="{Binding OpenDataFolderCommand}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Open log file" FontWeight="Normal" Command="{Binding OpenLogCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,16,0,0" Text="Fonts: IBM Plex (SIL Open Font License). Mail engine: MailKit / MimeKit (MIT)." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
