<Window x:Class="Magpie.App.Views.GatekeeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Magpie.App.Views"
        Style="{StaticResource Window.Dialog}" Width="560" Height="520" MinHeight="300" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Title="New senders — Magpie">
    <DockPanel Margin="22,18,22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Serif}" FontSize="19" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,14"
                       Text="These people haven't written to you before and you haven't written to them. Allow: they go straight to your Inbox from now on. Block: their mail goes to Spam, now and later. Nothing is deleted." />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Secondary}" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="OnClose" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Senders" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:GateRow}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Primary}" Content="Allow" Padding="14,5" Margin="8,0,6,0" Tag="{Binding}" Click="OnAllow"
                                            AutomationProperties.Name="{Binding AllowLabel}" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Block" Foreground="{DynamicResource Brush.Danger}" FontWeight="SemiBold" Padding="14,5" Tag="{Binding}" Click="OnBlock"
                                            AutomationProperties.Name="{Binding BlockLabel}" />
                                </StackPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" /></TextBlock>
                                    <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
