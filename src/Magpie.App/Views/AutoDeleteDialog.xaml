<Window x:Class="Magpie.App.Views.AutoDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Title="Auto-delete — Magpie">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Auto-delete future emails" Style="{StaticResource Text.Serif}" FontSize="19" />
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Emails that match go to Trash on their own. Pinned emails are never deleted, and you can keep any one of them." />

        <TextBlock Text="FROM" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
        <TextBox x:Name="Pattern" Style="{StaticResource TextBox.Field}" TextChanged="OnChanged" AutomationProperties.Name="From" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="An address (codes@bank.com), or *@xyz.com for everyone at xyz.com." />
        <TextBlock x:Name="PatternError" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Text="DELETE" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,6" />
        <RadioButton x:Name="AfterTime" GroupName="Kind" Content="After a set time" IsChecked="True" Checked="OnChanged" />
        <StackPanel x:Name="TimeGrid" Margin="24,8,0,0">
            <DockPanel Margin="0,0,0,4"><TextBlock Text="DAYS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" /><WrapPanel x:Name="DaysRow" /></DockPanel>
            <DockPanel Margin="0,0,0,4"><TextBlock Text="MONTHS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" /><WrapPanel x:Name="MonthsRow" /></DockPanel>
            <DockPanel><TextBlock Text="YEARS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,5,0,0" /><WrapPanel x:Name="YearsRow" /></DockPanel>
        </StackPanel>
        <RadioButton x:Name="Otp" GroupName="Kind" Margin="0,12,0,0" Checked="OnChanged">
            <StackPanel>
                <TextBlock Text="OTP — 24 hours after it arrives" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="460" Text="For one-time codes and sign-in links: useful for a day, then just clutter." />
            </StackPanel>
        </RadioButton>

        <TextBlock Text="ACCOUNTS" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,6" />
        <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnChanged" AutomationProperties.Name="Accounts" />

        <CheckBox x:Name="Existing" Margin="0,16,0,0" Content="Also start the timer on the emails already here from this sender" />

        <Border Background="{DynamicResource Brush.Header.Background}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="12.5" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="It will carry this tag:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border x:Name="PreviewTag" CornerRadius="4" Padding="6,1">
                        <TextBlock x:Name="PreviewTagText" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="Create rule" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
