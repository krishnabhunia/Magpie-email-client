<Window x:Class="Magpie.App.Views.AutoDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Title="Delete emails from… — Magpie">
    <!-- Design DX1-B1: one dialog for the emails already here (PAST) and those arriving later (FUTURE) -->
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Delete emails from…" Style="{StaticResource Text.Serif}" FontSize="19" />
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Deleted means Trash (Gmail keeps them 30 days). Pinned emails, Sent and Drafts are never deleted." />

        <TextBlock Text="FROM" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
        <TextBox x:Name="Pattern" Style="{StaticResource TextBox.Field}" TextChanged="OnChanged" AutomationProperties.Name="From" />
        <TextBlock x:Name="PatternHint" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="An address, or *@domain for everyone there." />
        <TextBlock x:Name="PatternError" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Text="KEEP THE LAST" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,6" />
        <WrapPanel x:Name="KeepChips" />
        <StackPanel x:Name="MoreGrid" Margin="0,6,0,0" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,4"><TextBlock Text="DAYS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" /><WrapPanel x:Name="DaysRow" /></DockPanel>
            <DockPanel Margin="0,0,0,4"><TextBlock Text="MONTHS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" /><WrapPanel x:Name="MonthsRow" /></DockPanel>
            <DockPanel><TextBlock Text="YEARS" Width="64" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,5,0,0" /><WrapPanel x:Name="YearsRow" /></DockPanel>
        </StackPanel>

        <CheckBox x:Name="PastTick" Margin="0,18,0,0" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Emails already here">
            <TextBlock TextWrapping="Wrap" MaxWidth="470"><Run Text="Emails already here" FontWeight="SemiBold" /><Run Text=" — " /><Run x:Name="PastLine" /></TextBlock>
        </CheckBox>
        <CheckBox x:Name="FutureTick" Margin="0,10,0,0" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Emails that arrive later">
            <TextBlock TextWrapping="Wrap" MaxWidth="470"><Run Text="Emails that arrive later" FontWeight="SemiBold" /><Run Text=" — " /><Run x:Name="FutureLine" /></TextBlock>
        </CheckBox>

        <TextBlock Text="ACCOUNTS" Style="{StaticResource Text.SectionCaps}" Margin="0,18,0,6" />
        <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnChanged" AutomationProperties.Name="Accounts" />

        <Border x:Name="PreviewBox" Background="{DynamicResource Brush.Header.Background}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12.5"><Run x:Name="PreviewText" /><Run Text=" " /><InlineUIContainer BaselineAlignment="Center"><Border x:Name="PreviewTag" CornerRadius="4" Padding="6,1"><TextBlock x:Name="PreviewTagText" FontSize="11.5" FontWeight="SemiBold" /></Border></InlineUIContainer><Run Text="." /></TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="Create rule" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
