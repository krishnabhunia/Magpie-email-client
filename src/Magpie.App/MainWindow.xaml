<Window x:Class="Magpie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Magpie.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:svc="clr-namespace:Magpie.App.Services"
        xmlns:views="clr-namespace:Magpie.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Magpie"
        Width="1320" Height="840" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}" FontSize="13"
        TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <!-- Shown only in the full sidebar (design H1: the icon rail hides labels, numbers and headings) -->
        <Style x:Key="WideOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WideOnly.Text" TargetType="TextBlock" BasedOn="{StaticResource WideOnly}" />
        <Style x:Key="WideOnly.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.SectionHeader}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Unread badge on a rail icon -->
        <Style x:Key="RailBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-5,-8,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.SidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding HasBadge}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Action bar on an email row (designs H3, RB1): on hover, always, or never -->
        <!-- Design RB4: the date gives its place to the row buttons, under the same conditions as RowBar below -->
        <Style x:Key="RowDate" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.RowActionsAlways, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MenuOpen}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.RowActionsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Hidden" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowBar" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.RowActionsAlways, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MenuOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.RowActionsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MaxMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Title bar (dark) ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar.Background}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Design B2: mail / calendar -->
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE787;" Command="{Binding ToggleCalendarCommand}" ToolTip="Calendar / mail (Ctrl+2 / Ctrl+1)" AutomationProperties.Name="Calendar" />
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE72C;" Command="{Binding SyncAllCommand}" ToolTip="Check for new mail (F5)" />
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE713;" Click="OnSettings" ToolTip="Settings" />
                    <!-- Update button (design UB1): always there; its colour and words follow UpdateService.State. DataContext = UpdateService (AttachUpdates). -->
                    <Grid x:Name="UpdateHost" Margin="6,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="UpdateButton" Style="{StaticResource Button.Update}" Command="{Binding TitleBarClickCommand}" ToolTip="{Binding ButtonTip}"
                                MouseRightButtonUp="OnUpdateRightClick" MouseEnter="OnUpdateHover" AutomationProperties.Name="{Binding ButtonText}" />
                        <Popup x:Name="UpdateFlyout" PlacementTarget="{Binding ElementName=UpdateButton}" Placement="Custom" CustomPopupPlacementCallback="PlaceUpdateFlyout"
                               IsOpen="{Binding FlyoutOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="400" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="8">
                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,10,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                    <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" MaxHeight="220" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Margin="0,0,8,4"
                                                IsEnabled="{Binding IsChecking, Converter={StaticResource InvBool}}" Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Cancel" FontWeight="Normal" Command="{Binding CancelDownloadCommand}" Margin="0,0,8,4"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Later" FontWeight="Normal" Command="{Binding LaterCommand}" Margin="0,0,8,4"
                                                Visibility="{Binding ShowLaterSkip, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Skip this version" FontWeight="Normal" Command="{Binding SkipCommand}" Margin="0,0,0,4"
                                                Visibility="{Binding ShowLaterSkip, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Release notes" FontSize="12" Padding="0" MinHeight="20" Command="{Binding OpenReleasePageCommand}" />
                                        <CheckBox Content="Auto update" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Checks at start and then once a day; downloads and installs in the background" />
                                        <CheckBox Content="Include test versions" IsChecked="{Binding IncludePrerelease, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Pre-releases made for a pull request" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Border Width="1" Margin="4,12" Background="{DynamicResource Brush.TitleBar.Hover}" />
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.TitleBar}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Maximize" />
                    <Button Style="{StaticResource Button.TitleBar.Close}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app-256.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" />
                    <TextBlock Text="Magpie" FontFamily="{StaticResource Font.Serif}" FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource Brush.TitleBar.Text}" VerticalAlignment="Center" />
                    <!-- Version (design V1): click for Settings → About -->
                    <Button Content="{Binding VersionText}" ToolTip="{Binding VersionTip}" Click="OnVersionClick" Margin="8,2,0,0" VerticalAlignment="Center" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True" Focusable="True" AutomationProperties.Name="{Binding VersionTip}"
                            Foreground="{DynamicResource Brush.TitleBar.Muted}" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TitleBar.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding ListTitle}" FontSize="12.5" Margin="18,1,0,0" Foreground="{DynamicResource Brush.TitleBar.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="18,1,0,0" Foreground="{DynamicResource Brush.TitleBar.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Body ═══ -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="{Binding SidebarColumnWidth, Mode=OneWay, Converter={StaticResource GridLen}}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ListColumn" Width="400" MinWidth="300" MaxWidth="700" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ─── Sidebar (design H1: drag its edge; narrower than 200 px becomes the icon rail) ─── -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}" ClipToBounds="True">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Button.Primary}" Margin="12,14,12,10" Command="{Binding ComposeCommand}" ToolTip="New message (Ctrl+N)" Padding="8,7">
                        <StackPanel Orientation="Horizontal">
                            <svc:IconChip Icon="compose" Size="16" Plain="True" Stroke="{DynamicResource Brush.Text.OnAccent}" />
                            <TextBlock Text="New message" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource WideOnly.Text}" />
                        </StackPanel>
                    </Button>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,8" />
                        <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Click="OnAddAccount" ToolTip="Add account">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Add account" Margin="8,0,0,0" Style="{StaticResource WideOnly.Text}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Folder details on hover (design H2); in the rail also the folder's name -->
                    <Popup x:Name="HoverPopup" DockPanel.Dock="Top" DataContext="{Binding HoverCard}" IsOpen="{Binding IsOpen, Mode=TwoWay}" StaysOpen="True" Placement="Right" HorizontalOffset="6"
                           AllowsTransparency="True" PopupAnimation="Fade" IsHitTestVisible="False">
                        <Border Width="260" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <svc:IconChip DockPanel.Dock="Left" Icon="{Binding IconKey}" Size="26" Margin="0,0,10,0" Visibility="{Binding IsTag, Converter={StaticResource InvBoolToVis}}" />
                                    <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" Background="{Binding TagColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="4,0,14,0"
                                            Visibility="{Binding IsTag, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HoverLine}">
                                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding Brush}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                    <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,8">
                            <!-- Collapsible sections (design Q2). A closed section still shows what matters. -->
                            <ToggleButton Style="{StaticResource WideOnly.Toggle}" IsChecked="{Binding FoldersOpen, Mode=TwoWay}" Margin="8,2,8,4"
                                          AutomationProperties.Name="Folders" ToolTip="Show or hide folders">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Accent}" CornerRadius="8" Padding="6,0"
                                            Visibility="{Binding FoldersBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding FoldersBadge}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="10.5" />
                                    </Border>
                                    <TextBlock Text="FOLDERS" VerticalAlignment="Center" />
                                </DockPanel>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding Smart}" Visibility="{Binding FoldersOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NavItem}">
                                        <RadioButton Style="{StaticResource Button.Folder}" IsChecked="{Binding IsSelected, Mode=OneWay}" MouseEnter="OnNavEnter" MouseLeave="OnNavLeave"
                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid HorizontalAlignment="Left">
                                                    <svc:IconChip Icon="{Binding IconKey}" Size="24" />
                                                    <Border Style="{StaticResource RailBadge}" Background="{Binding CountBrush}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource WideOnly.Text}" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}">
                                                    <Run Text="{Binding CountMain, Mode=OneWay}" Foreground="{Binding CountBrush}" FontWeight="{Binding CountBold, Converter={StaticResource BoldIfTrue}}" /><Run Text="{Binding CountRest, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </TextBlock>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Design B2: the calendar, under the folders -->
                            <RadioButton Style="{StaticResource Button.Folder}" IsChecked="{Binding IsCalendarView, Mode=OneWay}" Command="{Binding ShowCalendarCommand}"
                                         ToolTip="Calendar (Ctrl+2)" AutomationProperties.Name="Calendar">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <svc:IconChip Icon="calendar" Size="24" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="Calendar" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}" />
                                </Grid>
                            </RadioButton>
                            <Border Style="{StaticResource Divider}" Margin="14,8" Visibility="{Binding SidebarRail, Converter={StaticResource BoolToVis}}" />
                            <Grid Style="{StaticResource WideOnly}">
                                <ToggleButton Style="{StaticResource Toggle.SectionHeader}" IsChecked="{Binding AccountsOpen, Mode=TwoWay}"
                                              AutomationProperties.Name="Accounts" ToolTip="Show or hide accounts"
                                              Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AccountsWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="10.5" FontWeight="Normal" VerticalAlignment="Center" />
                                        <TextBlock Text="ACCOUNTS" VerticalAlignment="Center" />
                                    </DockPanel>
                                </ToggleButton>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AccountNodes}" Visibility="{Binding AccountsOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccountNode}">
                                        <StackPanel>
                                            <ToggleButton Style="{StaticResource Toggle.Account}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" ToolTip="{Binding Tip}"
                                                          AutomationProperties.Name="{Binding Email}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Email}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UnreadText}" FontSize="12" FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource WideOnly.Text}" />
                                                    <TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </ToggleButton>
                                            <Button Style="{StaticResource Button.Link}" Content="Sign in again" HorizontalAlignment="Left" Margin="30,0,0,4" FontSize="12"
                                                    Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVis}}" Click="OnReauth" Tag="{Binding}" />
                                            <ItemsControl ItemsSource="{Binding Folders}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NavItem}">
                                                        <RadioButton Style="{StaticResource Button.Folder}" IsChecked="{Binding IsSelected, Mode=OneWay}" Height="30" MouseEnter="OnNavEnter" MouseLeave="OnNavLeave"
                                                                     Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Margin" Value="{Binding Indent}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.SidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                <Setter Property="Margin" Value="0" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="18" Style="{StaticResource WideOnly}">
                                                                    <Button Style="{StaticResource Button.FolderChevron}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.ToggleFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            ToolTip="Show or hide subfolders" />
                                                                </Grid>
                                                                <Grid Grid.Column="1" HorizontalAlignment="Left">
                                                                    <svc:IconChip Icon="{Binding IconKey}" Size="21" />
                                                                    <Border Style="{StaticResource RailBadge}" Background="{Binding CountBrush}">
                                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource WideOnly.Text}" />
                                                                <TextBlock Grid.Column="3" FontSize="11.5" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}">
                                                                    <Run Text="{Binding CountMain, Mode=OneWay}" Foreground="{Binding CountBrush}" FontWeight="{Binding CountBold, Converter={StaticResource BoldIfTrue}}" /><Run Text="{Binding CountRest, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Divider}" Margin="14,8" Visibility="{Binding SidebarRail, Converter={StaticResource BoolToVis}}" />
                            <ToggleButton Style="{StaticResource WideOnly.Toggle}" IsChecked="{Binding TagsOpen, Mode=TwoWay}"
                                          AutomationProperties.Name="Tags" ToolTip="Show or hide tags">
                                <TextBlock Text="TAGS" VerticalAlignment="Center" />
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding TagItems}" Visibility="{Binding TagsOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NavItem}">
                                        <RadioButton Style="{StaticResource Button.Folder}" IsChecked="{Binding IsSelected, Mode=OneWay}" Height="30" MouseEnter="OnNavEnter" MouseLeave="OnNavLeave"
                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11.5" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}">
                                                    <Run Text="{Binding CountMain, Mode=OneWay}" Foreground="{Binding TagColor, Converter={StaticResource HexBrush}}" FontWeight="{Binding CountBold, Converter={StaticResource BoldIfTrue}}" /><Run Text="{Binding CountRest, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                </TextBlock>
                                                <Grid DockPanel.Dock="Left" Margin="6,0,12,0" VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding TagColor, Converter={StaticResource HexBrush}}" />
                                                    <Border Style="{StaticResource RailBadge}" Background="{Binding TagColor, Converter={StaticResource HexBrush}}" Margin="0,-10,-12,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" Style="{StaticResource WideOnly.Text}" />
                                            </DockPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Drag to resize the sidebar · double-click to reset (design H1) -->
            <Thumb Grid.Column="1" x:Name="SidebarHandle" Width="7" Cursor="SizeWE" DragStarted="OnSidebarDragStarted" DragDelta="OnSidebarDragDelta" DragCompleted="OnSidebarDragCompleted"
                   MouseDoubleClick="OnSidebarHandleDoubleClick" ToolTip="Drag to resize the sidebar · double-click to reset" Focusable="False">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Sidebar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
                            <Border x:Name="Grip" Width="3" Height="36" CornerRadius="2" Background="{DynamicResource Brush.Text.Tertiary}" Opacity="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Nav.Hover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- ─── Message list ─── -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsCalendarView, Converter={StaticResource InvBoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,12,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Button.Chip}" IsChecked="{Binding UnreadOnly, Mode=TwoWay}" Content="Unread" FontSize="12" MinHeight="28" Padding="10,3" ToolTip="Show unread conversations only" />
                        </StackPanel>
                        <TextBlock Text="{Binding Current.Label}" FontFamily="{StaticResource Font.Serif}" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBox Grid.Row="1" x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Margin="14,0,14,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search  (from:  subject:  has:attachment  is:unread)"
                             PreviewKeyDown="OnSearchKey" />

                    <StackPanel Grid.Row="2">
                    <!-- Gatekeeper (design B7): new senders wait at the door -->
                    <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Margin="14,0,14,8" Padding="12,7"
                            Visibility="{Binding ShowGateBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Review" FontWeight="SemiBold" Padding="6,0" MinHeight="22" Command="{Binding ReviewGateCommand}" />
                            <TextBlock Text="{Binding GateBannerText}" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <!-- Deleting soon (design AD4) -->
                    <DockPanel Margin="16,0,14,8" Visibility="{Binding IsDeletingSoonView, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Keep all" Padding="6,0" MinHeight="22" Command="{Binding KeepAllDeletingCommand}"
                                ToolTip="Take the auto-delete timer off all of these" />
                        <TextBlock Text="These go to Trash within 7 days (auto-delete rules). Pinned mail is always kept." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <!-- Trash / Spam (design TB1): how many, and Empty -->
                    <DockPanel Margin="16,0,14,8" Visibility="{Binding IsBinView, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Content="{Binding EmptyBinLabel}" MinHeight="28" Padding="12,3"
                                Command="{Binding EmptyBinCommand}" ToolTip="Delete everything here for good (asks first)" />
                        <TextBlock Text="{Binding BinBarText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                    </DockPanel>
                    <!-- Set aside pile (design B7) -->
                    <DockPanel Margin="16,0,14,8" Visibility="{Binding IsSetAsideView, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Clear all" Padding="6,0" MinHeight="22" Command="{Binding ClearSetAsideCommand}"
                                ToolTip="Put every conversation here back in the Inbox" />
                        <TextBlock Text="Out of the Inbox, without a date. L or Set aside puts one back." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,0" Visibility="{Binding ShowCategories, Converter={StaticResource BoolToVis}}">
                        <RadioButton Style="{StaticResource Button.Tab}" GroupName="Cat" IsChecked="{Binding Category, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=People}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="People" ToolTip="Mail from people">
                            <TextBlock><Run Text="People" /><Run Text=" " /><Run Text="{Binding PeopleCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent.Text}" FontSize="11.5" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Button.Tab}" GroupName="Cat" IsChecked="{Binding Category, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Notifications}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Notifications" ToolTip="Receipts, alerts, codes, updates">
                            <TextBlock><Run Text="Notifications" /><Run Text=" " /><Run Text="{Binding NotificationsCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11.5" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Button.Tab}" GroupName="Cat" IsChecked="{Binding Category, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Newsletters}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Newsletters" ToolTip="Newsletters and mailing lists">
                            <TextBlock><Run Text="Newsletters" /><Run Text=" " /><Run Text="{Binding NewslettersCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11.5" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Button.Tab}" GroupName="Cat" IsChecked="{Binding Category, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=''}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="All" Content="All" />
                    </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Design SL1: the box above the list ticks all / none; Select ▾ ticks by filter -->
                            <DockPanel Grid.Row="0" Margin="16,6,14,6" Visibility="{Binding IsScheduledView, Converter={StaticResource InvBoolToVis}}">
                                <CheckBox x:Name="HeaderCheck" IsThreeState="False" IsChecked="{Binding HeaderTick, Mode=OneWay}" Click="OnHeaderCheck" VerticalAlignment="Center"
                                          ToolTip="Select all on screen / none (Ctrl+A, Esc)" AutomationProperties.Name="Select all" Margin="0,0,10,0" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Select ▾" FontSize="12" MinHeight="26" Padding="8,2" Click="OnSelectMenu" VerticalAlignment="Center"
                                        ToolTip="Select by unread, sender, date…" />
                                <TextBlock Text="{Binding ListCountText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <!-- Bulk bar (design H3, SL1): act on everything ticked; Undo while it waits -->
                            <Border Grid.Row="1" Background="{DynamicResource Brush.TitleBar.Background}" Padding="12,6" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="✕" Foreground="#9AA1A8" MinHeight="24" Padding="6,0" ToolTip="Clear selection (Esc)" Click="OnBulkClear" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Undo" Foreground="#9FE3EC" FontWeight="SemiBold" MinHeight="24" Padding="8,0" Click="OnBulkUndo"
                                            Visibility="{Binding BulkPending, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding BulkPendingText}" Foreground="{DynamicResource Brush.TitleBar.Text}" VerticalAlignment="Center" FontSize="12.5"
                                               Visibility="{Binding BulkPending, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel VerticalAlignment="Center" Visibility="{Binding BulkPending, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource Brush.TitleBar.Text}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <!-- In Trash: Restore and Delete forever (design TB1); in Spam: Not spam -->
                                        <Button Style="{StaticResource Button.Bulk}" Content="Restore" Tag="restore" Click="OnBulkAction" Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Not spam" Tag="notspam" Click="OnBulkAction" Visibility="{Binding IsSpamView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Delete forever" Tag="deleteforever" Click="OnBulkAction" Visibility="{Binding IsBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Archive" Tag="archive" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Delete" Tag="delete" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Mark read" Tag="markread" Click="OnBulkAction" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Mark unread" Tag="unread" Click="OnBulkAction" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Move ▾" Tag="move" Click="OnBulkAction" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Tag ▾" Tag="tag" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Snooze ▾" Tag="snooze" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Pin" Tag="pin" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Bulk}" Content="Spam" Tag="spam" Click="OnBulkAction" Visibility="{Binding IsNotBinView, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- Design SL1 (F12): everything on screen is ticked but the view holds more -->
                            <Border Grid.Row="2" Background="{DynamicResource Brush.Accent.Subtle}" Padding="16,6" Visibility="{Binding ShowSelectAllHint, Converter={StaticResource BoolToVis}}">
                                <WrapPanel>
                                    <TextBlock Text="{Binding SelectAllHintText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Button.Link}" Content="{Binding SelectAllLinkText}" FontSize="12.5" FontWeight="SemiBold" MinHeight="20" Padding="0"
                                            Command="{Binding SelectAllInViewCommand}" />
                                </WrapPanel>
                            </Border>

                            <ListBox Grid.Row="3" x:Name="ThreadList" ScrollViewer.ScrollChanged="OnThreadListScroll" Style="{StaticResource ListBox.Mail}" ItemsSource="{Binding Threads}" SelectedItem="{Binding Selected, Mode=TwoWay}" PreviewMouseLeftButtonUp="OnThreadListClick"
                                     Visibility="{Binding IsScheduledView, Converter={StaticResource InvBoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThreadItem}">
                                        <Grid Loaded="OnRowLoaded">
                                        <!-- Design DD1 (L3): a red strip on the left edge of every email that will be deleted -->
                                        <Border Width="4" HorizontalAlignment="Left" Margin="-16,-10,0,-10" Background="{DynamicResource Brush.Danger}"
                                                Visibility="{Binding ShowEdge, Converter={StaticResource BoolToVis}}" />
                                        <DockPanel>
                                        <!-- Design SL1 (F0): a tick box on every row, always there; Shift+click ticks a range -->
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=OneWay}" VerticalAlignment="Top" Margin="0,10,9,0" Focusable="False"
                                                  PreviewMouseLeftButtonDown="OnRowCheck" AutomationProperties.Name="Select this conversation"
                                                  Visibility="{Binding IsLocalDraft, Converter={StaticResource InvBoolToVis}}" />
                                        <!-- Avatar: click it to tick the conversation for a bulk action (design H3) -->
                                        <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Top" Margin="0,2,11,0" Background="Transparent" Cursor="Hand"
                                              PreviewMouseLeftButtonDown="OnAvatarClick" ToolTip="Select for a bulk action">
                                            <Border CornerRadius="17" Background="{Binding AvatarBrush}" Visibility="{Binding IsChecked, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="17" BorderThickness="2" BorderBrush="White" Opacity="0.85" Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVis}}" />
                                            <Border CornerRadius="17" Background="{DynamicResource Brush.Accent}" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="✓" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <!-- Design RB4 (approved 30 Sep 2026): the chosen buttons take the date's place on the first line, the same
                                                     spot on every row; one size, even gaps, ⋯ last. On hover (or always / never, Settings → Appearance). -->
                                                <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border Visibility="{Binding ShowDeleteDay, Converter={StaticResource InvBoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource RowDate}" Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding DateTip}" />
                                                    </Border>
                                                    <!-- Design DD1 (L2): the date becomes the delete date; the arrival date moves under it -->
                                                    <Border Visibility="{Binding ShowDeleteDay, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource RowDate}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding DateTip}">
                                                            <Run Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="10.5" /><Run Text=" " /><Run Text="{Binding DeleteDay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Style="{StaticResource RowBar}" Background="Transparent" Margin="0,-5,-4,-5" ToolTip="{Binding DateTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ItemsControl ItemsSource="{Binding DataContext.RowActionButtons, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:ToolbarButtonVm}">
                                                                        <Button Style="{StaticResource Button.RowAction}" Width="26" Height="26" Margin="0,0,4,0" Tag="{Binding}" Click="OnRowAction"
                                                                                ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                                                                            <svc:IconChip Icon="{Binding IconKey}" Size="16" Plain="True" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Style="{StaticResource Button.RowAction}" Width="26" Height="26" Margin="0" Click="OnRowMore" ToolTip="More actions" AutomationProperties.Name="More actions">
                                                                <TextBlock Text="⋯" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent.Text}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                                    <Ellipse Width="7" Height="7" Fill="{Binding AccountColor, Converter={StaticResource HexBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" Opacity="0.55"
                                                             Visibility="{Binding ShowAccountDot, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Sender}" FontSize="13.5" FontWeight="{Binding IsUnread, Converter={StaticResource BoldIfTrue}}" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <!-- Design DD1 (L3): a small clock after the sender -->
                                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Danger}" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               ToolTip="{Binding DeleteTagTip}" Visibility="{Binding ShowEdge, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Design DD1 (L4): a ring that empties as the time runs out -->
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding DeleteTagTip}"
                                                                Visibility="{Binding ShowRing, Converter={StaticResource BoolToVis}}">
                                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                            <Path Stroke="{DynamicResource Brush.Control.Border}" StrokeThickness="2.5">
                                                                <Path.Data><EllipseGeometry Center="7,7" RadiusX="5.5" RadiusY="5.5" /></Path.Data>
                                                            </Path>
                                                            <Path Data="{Binding RingGeometry}" Stroke="{Binding DeleteTagFg}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding DeleteShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding DeleteTagFg}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               ToolTip="Arrived" Visibility="{Binding ShowDeleteDay, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding DeleteShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               ToolTip="{Binding DeleteTagTip}" Visibility="{Binding ShowEdge, Converter={StaticResource BoolToVis}}" />
                                                    <Border Background="{DynamicResource Brush.Badge.Local.Background}" CornerRadius="9" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding LocalBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding LocalBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Badge.Local.Text}" />
                                                    </Border>
                                                    <TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0"
                                                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" ToolTip="Has attachments" />
                                                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="{DynamicResource Brush.Accent.Text}" Margin="6,0,0,0"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" ToolTip="Pinned" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subject}" FontSize="13" FontWeight="{Binding IsUnread, Converter={StaticResource BoldIfTrue}}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="2" Text="{Binding Preview}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <WrapPanel Grid.Row="3" Margin="0,4,0,0" Visibility="{Binding HasTagLine, Converter={StaticResource BoolToVis}}">
                                                <!-- Design DD1: L1 countdown pill (red < 48 h, amber < 30 days, grey later); H3 grows it to the full date and rule
                                                     while the mouse is on the row (and shows it then under L2–L4) -->
                                                <Border CornerRadius="9" Background="{Binding DeleteTagBg}" Margin="0,0,6,0" Padding="7,1" ToolTip="{Binding DeleteTagTip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowPill}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding GrowPill}" Value="True" />
                                                                        <Condition Binding="{Binding ShowPill}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding GrowPill}" Value="True" />
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Foreground="{Binding DeleteTagFg}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding DeleteTagFg}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding DeleteTag}" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding GrowPill}" Value="True" />
                                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{Binding DeleteTagLong}" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding TagChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TagChip}">
                                                            <Border CornerRadius="9" Background="{Binding Background}" Margin="0,0,6,0" Padding="8,1">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="4" Text="{Binding SnoozeText}" FontSize="11.5" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,3,0,0"
                                                       Visibility="{Binding SnoozeText, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <!-- Filled when it opens, in the toolbar's order (design C3) -->
                                    <ContextMenu x:Name="ListMenu" Opened="OnListMenuOpened" />
                                </ListBox.ContextMenu>
                            </ListBox>

                            <!-- Scheduled (send later) list -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsScheduledView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Scheduled}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScheduledItem}">
                                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="16,10,14,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding To}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding When}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Style="{StaticResource Button.Toolbar}" Content="Send now"
                                                                Command="{Binding DataContext.SendScheduledNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource Button.Toolbar}" Content="Cancel &amp; edit"
                                                                Command="{Binding DataContext.CancelScheduledCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="30" MaxWidth="280" IsHitTestVisible="False"
                                       Visibility="{Binding EmptyText, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Undo send -->
                    <!-- Undo send: one row per message, newest at the bottom (design F2) -->
                    <StackPanel Grid.Row="4" Background="{DynamicResource Brush.TitleBar.Background}">
                        <ItemsControl ItemsSource="{Binding VisibleToasts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UndoToast}">
                                    <Border BorderBrush="#2C3238" BorderThickness="0,0,0,1" Padding="14,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Undo" Foreground="#9FE3EC" MinHeight="24" Padding="8,2"
                                                    Command="{Binding DataContext.UndoSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasButtons, Converter={StaticResource BoolToVis}}" ToolTip="Undo (Ctrl+Z)" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{Binding EditText}" Foreground="#9FE3EC" MinHeight="24" Padding="8,2"
                                                    Command="{Binding DataContext.EditToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasEdit, Converter={StaticResource BoolToVis}}" />
                                            <!-- Send now (design SN1): skip the rest of the wait -->
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.SendNow}" Content="Send now" Margin="6,0"
                                                    Command="{Binding DataContext.SendNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanSendNow, Converter={StaticResource BoolToVis}}" ToolTip="Send it right away (Ctrl+Shift+Enter)" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Countdown}" Foreground="#9AA1A8" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,4,0" />
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Brush.TitleBar.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Button.Link}" Content="{Binding ToastOverflow}" Foreground="#9FE3EC" FontSize="12" HorizontalAlignment="Left" Margin="14,4,0,6"
                                Command="{Binding ShowScheduledViewCommand}" Visibility="{Binding ToastOverflow, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="OnSplitterDragged"
                          Visibility="{Binding IsCalendarView, Converter={StaticResource InvBoolToVis}}" />

            <!-- ─── Calendar (design B2): in place of the list and the reading pane ─── -->
            <views:CalendarView Grid.Column="2" Grid.ColumnSpan="3" DataContext="{Binding Cal}"
                                Visibility="{Binding DataContext.IsCalendarView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- ─── Reading pane ─── -->
            <Grid Grid.Column="4" Background="{DynamicResource Brush.Card.Background}" DataContext="{Binding Reader}"
                  Visibility="{Binding DataContext.IsCalendarView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar (S4: the indigo Summarise button only exists when that switch is on) -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="18,10" Visibility="{Binding HasThread, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                            <Button Style="{StaticResource Button.Ai}" Margin="0,0,8,0" MinHeight="34" Padding="12,5" Command="{Binding SummariseCommand}"
                                    Visibility="{Binding ShowSummarise, Converter={StaticResource BoolToVis}}" ToolTip="Summarise this conversation with your AI provider">
                                <StackPanel Orientation="Horizontal">
                                    <svc:IconChip Icon="summarise" Size="14" Plain="True" Stroke="White" Margin="0,0,6,0" />
                                    <TextBlock Text="Summarise" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" MinHeight="34" Padding="14,5" Command="{Binding ReplyCommand}" ToolTip="Reply (R)">
                                <StackPanel Orientation="Horizontal">
                                    <svc:IconChip Icon="reply" Size="14" Plain="True" Stroke="{DynamicResource Brush.Text.OnAccent}" Margin="0,0,6,0" />
                                    <TextBlock Text="Reply" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Icon + name on every button, in the order chosen in Settings → Toolbar & buttons (designs C1, C3) -->
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding DataContext.ToolbarButtons, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToolbarButtonVm}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.ToolbarIcon}" Tag="{Binding}" Click="OnToolbarButton" ToolTip="{Binding ToolTip}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <svc:IconChip Icon="{Binding IconKey}" Size="22" Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0,2,0" Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Button>
                                            <!-- Delete ▾ (design AD1): auto-delete this sender's future emails -->
                                            <Button Style="{StaticResource Button.ToolbarIcon}" Content="▾" Padding="4,0" MinWidth="18" Margin="-4,0,6,4" Click="OnDeleteDropdown"
                                                    ToolTip="Delete now, or auto-delete future emails from this sender" AutomationProperties.Name="Delete options"
                                                    Visibility="{Binding HasDropdown, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Button.ToolbarIcon}" Click="OnMoreMenu" ToolTip="More actions" AutomationProperties.Name="More actions">
                                <svc:IconChip Icon="more" Size="22" />
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- Subject -->
                <StackPanel Grid.Row="1" Margin="24,16,24,8" Visibility="{Binding HasThread, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE718;" Command="{Binding TogglePinCommand}" ToolTip="Pin (P)"
                                Foreground="{DynamicResource Brush.Accent.Text}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE718;" Command="{Binding TogglePinCommand}" ToolTip="Pin (P)"
                                Visibility="{Binding IsPinned, Converter={StaticResource InvBoolToVis}}" />
                        <!-- Design DD1 (R2): a chip next to the subject; pointing at it (or a click) shows the rule with Keep / Change rule -->
                        <Border x:Name="DeleteChip" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Margin="10,5,6,0" VerticalAlignment="Top" Background="{Binding DeleteChipBg}"
                                Cursor="Hand" Focusable="True" AutomationProperties.Name="{Binding DeleteChipText}" Visibility="{Binding ShowDeleteChip, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="{Binding DeleteChipFg}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeleteChipText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding DeleteChipFg}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Design HM1: resting the mouse here (or right-click / Menu key) opens the subject card -->
                        <TextBlock x:Name="SubjectText" Text="{Binding Subject}" Style="{StaticResource Text.Serif}" FontSize="19" TextWrapping="Wrap" TextTrimming="None"
                                   Focusable="True" AutomationProperties.Name="Subject — press the Menu key for actions" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="{Binding TagsText}" FontSize="12" Foreground="{DynamicResource Brush.Accent.Text}" Margin="10,0,0,0" />
                        <Button Style="{StaticResource Button.Link}" Content="Unsnooze" FontSize="12" MinHeight="18" Padding="10,0,0,0" Command="{Binding UnsnoozeCommand}"
                                Visibility="{Binding IsSnoozed, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Button.Link}" Content="Edit draft" FontSize="12" MinHeight="18" Padding="10,0,0,0" Command="{Binding EditDraftCommand}"
                                Visibility="{Binding IsDraftFolder, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- AI summary card (B3/B4/B5) -->
                <Border Grid.Row="2" Style="{StaticResource Card.Ai}" Margin="24,0,24,10" Visibility="{Binding SummaryVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Ghost}" Content="Regenerate" FontSize="12" MinHeight="24" Padding="8,2" Command="{Binding RegenerateSummaryCommand}"
                                        Visibility="{Binding SummaryText, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Copy" FontSize="12" MinHeight="24" Padding="8,2" Command="{Binding CopySummaryCommand}"
                                        Visibility="{Binding SummaryText, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Hide" FontSize="12" MinHeight="24" Padding="8,2" Command="{Binding HideSummaryCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Summary" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" />
                                <TextBlock Text="{Binding ProviderLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="8,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ai.Text}" Margin="0,8,0,0" LineHeight="20"
                                   Visibility="{Binding SummaryText, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding SummaryBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="80" Height="3" VerticalAlignment="Center" />
                            <TextBlock Text="Summarising…" FontSize="12" Foreground="{DynamicResource Brush.Ai.Text}" Margin="10,0,0,0" />
                        </StackPanel>
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding SummaryError, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.AiChip}" Content="Try again" Command="{Binding RegenerateSummaryCommand}" />
                            <TextBlock Text="{Binding SummaryError}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding SummaryNeedsSetup, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ai}" Content="Set up AI provider" Command="{Binding OpenAiSettingsCommand}" MinHeight="28" Padding="10,3" />
                            <TextBlock Text="Summaries need an AI provider. Your mail keeps working without one." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ai.Text}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding SummaryNote}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,6,0,0"
                                   Visibility="{Binding SummaryNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Remote images blocked -->
                <StackPanel Grid.Row="3">
                <!-- Meeting invite (design B3) -->
                <Border Style="{StaticResource Card}" Margin="24,0,24,10" Padding="14,12" Visibility="{Binding HasInvite, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <!-- Date tile: month band / day / weekday -->
                        <Border DockPanel.Dock="Left" Width="58" CornerRadius="8" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="{DynamicResource Brush.Accent}" CornerRadius="7,7,0,0" Padding="0,2">
                                    <TextBlock Text="{Binding InviteMonth}" Foreground="{DynamicResource Brush.Text.OnAccent}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding InviteDay}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding InviteWeekday}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding InviteTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InviteWhen}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InviteWhere}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"
                                       Visibility="{Binding HasInviteWhere, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Button.Link}" Content="Join the video call" HorizontalAlignment="Left" Padding="0,1" MinHeight="20"
                                    Command="{Binding OpenInviteMeetCommand}" ToolTip="{Binding InviteMeet}" Visibility="{Binding HasInviteMeet, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding InviteWho}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding InviteClash}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasInviteClash, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding InviteStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasInviteStatus, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Visibility="{Binding CanAnswerInvite, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <WrapPanel>
                                    <Button Style="{StaticResource Button.Primary}" Content="Accept" Padding="16,5" MinHeight="30" Margin="0,0,8,4" Command="{Binding AnswerInviteChoiceCommand}" CommandParameter="Accepted" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Maybe" Padding="16,5" MinHeight="30" Margin="0,0,8,4" Command="{Binding AnswerInviteChoiceCommand}" CommandParameter="Tentative" />
                                    <Button Style="{StaticResource Button.Secondary}" Content="Decline" Foreground="{DynamicResource Brush.Danger}" Padding="16,5" MinHeight="30" Margin="0,0,8,4"
                                            Command="{Binding AnswerInviteChoiceCommand}" CommandParameter="Declined" />
                                    <CheckBox Content="Add a note to my reply" IsChecked="{Binding AddInviteNote, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,4" />
                                </WrapPanel>
                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding InviteNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                         VerticalContentAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="Note to the organiser"
                                         Visibility="{Binding AddInviteNote, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Auto-delete timer: design DD1 (R1) — full date and time, the rule, Keep / Change rule and a bar of the time left -->
                <Border Background="{DynamicResource Brush.Danger.Subtle}" CornerRadius="6" Padding="12,8,12,8" Margin="24,0,24,8"
                        Visibility="{Binding ShowDeleteBanner, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Primary}" Content="Keep this one" FontSize="12" MinHeight="26" Padding="10,2" Margin="8,0,6,0" Command="{Binding KeepFromAutoDeleteCommand}"
                                        ToolTip="Take the timer off this email (pinning it keeps it too)" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Change rule" FontSize="12" MinHeight="26" Padding="10,2" Click="OnChangeDeleteRule" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="14" Foreground="{DynamicResource Brush.Danger}" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap">
                                    <Run Text="{Binding DeleteBannerDate, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding DeleteBannerLeft, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding DeleteRuleText}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Height="4" Margin="0,8,0,0" ToolTip="Time left before it moves to Trash">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DeleteBarLeft}" />
                                <ColumnDefinition Width="{Binding DeleteBarGone}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Brush.Control.Border}" />
                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource Brush.Danger}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="6" Padding="12,6" Margin="24,0,24,8"
                        Visibility="{Binding BlockedImages, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Link}" Content="Load images" FontSize="12" MinHeight="22" Padding="6,0" Command="{Binding LoadImagesCommand}" />
                            <Button Style="{StaticResource Button.Link}" Content="Always from this sender" FontSize="12" MinHeight="22" Padding="6,0" Command="{Binding TrustSenderCommand}" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Pictures from the internet are blocked to protect your privacy (" /><Run Text="{Binding BlockedImages, Mode=OneWay}" /><Run Text=")." />
                        </TextBlock>
                    </DockPanel>
                </Border>
                </StackPanel>

                <!-- Conversation (WebView2) -->
                <Grid Grid.Row="4">
                    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="White" />
                    <Border x:Name="NoRuntime" Visibility="Collapsed" Background="{DynamicResource Brush.Card.Background}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Reading pane needs Microsoft Edge WebView2" Style="{StaticResource Text.Serif}" FontSize="17" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,12"
                                       Text="It is part of Windows 11 and most Windows 10 PCs. Install the free Evergreen runtime from Microsoft, then restart Magpie." />
                            <Button Style="{StaticResource Button.Secondary}" Content="Get WebView2 runtime" HorizontalAlignment="Left" Click="OnGetWebView2" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="5">
                <!-- Quick replies (design B6): one click sends, with the normal Undo -->
                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="22,8"
                        Visibility="{Binding ShowQuickReplies, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Quick reply" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Text}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ItemsControl ItemsSource="{Binding QuickReplies}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.QuickChip}" Margin="0,2,8,2" MaxWidth="300" ToolTip="Send this reply now (you can Undo for a few seconds)"
                                            Command="{Binding DataContext.Reader.SendQuickReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <!-- Suggested replies (C5): only when that switch is on -->
                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="22,10" Background="{DynamicResource Brush.Ai.Tint}"
                        Visibility="{Binding ShowReplies, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Suggested replies" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" />
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.AiChip}" Content="Suggest replies" Command="{Binding GenerateRepliesCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding RepliesNeedClick, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Thinking…" FontSize="12" Foreground="{DynamicResource Brush.Ai.Text}" VerticalAlignment="Center"
                                       Visibility="{Binding RepliesBusy, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Replies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.AiChip}" Margin="0,0,8,4" MaxWidth="340" ToolTip="Open a reply with this text — you review before sending"
                                                Command="{Binding DataContext.Reader.UseReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RepliesError}" FontSize="12" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding RepliesError, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══ Status bar (design S1): one row, what Magpie is doing right now ═══ -->
        <Border Grid.Row="2" x:Name="StatusBarRow" DataContext="{Binding StatusBar}" Height="28" Background="{DynamicResource Brush.Sidebar.Background}"
                BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,1,0,0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <DockPanel Margin="12,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.StatusRight}" Command="{Binding TogglePanelCommand}" ToolTip="Show activity">
                        <TextBlock Text="{Binding RightText}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding Segments}" Focusable="False" VerticalAlignment="Center" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatusSegment}">
                                <Border BorderBrush="{DynamicResource Brush.Divider}" Padding="10,0" Margin="0" BorderThickness="{Binding IsFirst, Converter={StaticResource FirstSegmentBorder}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svc:IconChip Icon="{Binding IconKey}" Size="13" Plain="True" Stroke="{Binding Brush}" Margin="0,0,6,0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <Border Width="60" Height="5" CornerRadius="3" Background="{DynamicResource Brush.Divider}" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                            <Border Width="{Binding ProgressWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Brush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" FontWeight="{Binding Bold, Converter={StaticResource BoldIfTrue}}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Button.Link}" Content="{Binding Link2}" Command="{Binding Link2Command}" FontSize="12" FontWeight="SemiBold" MinHeight="18" Padding="8,0,0,0"
                                                Foreground="{DynamicResource Brush.Success}" Visibility="{Binding HasLink2, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Link}" Content="{Binding Link}" Command="{Binding LinkCommand}" FontSize="12" FontWeight="SemiBold" MinHeight="18" Padding="8,0,0,0"
                                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Activity panel -->
                <Popup IsOpen="{Binding PanelOpen, Mode=TwoWay}" StaysOpen="False" Placement="Top" HorizontalOffset="12" VerticalOffset="-4" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="700" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="10" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="16,12,10,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Check all now" Command="{Binding SyncAllCommand}" FontSize="12" MinHeight="20" />
                                <TextBlock Text="Activity" FontWeight="SemiBold" FontSize="14" />
                            </DockPanel>
                            <Grid Margin="16,0,16,4" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Account" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Now" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Last sync" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="New today" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Outbox" FontWeight="SemiBold" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccountActivity}">
                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,7">
                                            <Grid TextElement.FontSize="12.5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Email}" TextTrimming="CharacterEllipsis" MaxWidth="195" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Now}" Foreground="{Binding NowBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding LastSync}" />
                                                <TextBlock Grid.Column="3" Text="{Binding NewToday}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Outbox}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,8,16,12">
                                <StackPanel>
                                    <TextBlock Text="Nothing yet this session." FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               Visibility="{Binding Log.Count, Converter={StaticResource ZeroToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Log}" Focusable="False" MaxHeight="200">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ActivityEntry}">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,1">
                                                    <Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Text, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
