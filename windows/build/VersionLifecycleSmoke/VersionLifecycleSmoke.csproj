<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Match production: late assembly loads must survive replacement of the running bundle. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <StartupObject>VersionLifecycleSmoke.Program</StartupObject>
    <LifecycleFixture Condition="'$(LifecycleFixture)' == ''">original</LifecycleFixture>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Magpie.App/Magpie.App.csproj" />
    <!-- Two builds have distinct executable hashes without patching a PE or changing the recovery code. -->
    <AssemblyMetadata Include="LifecycleFixture" Value="$(LifecycleFixture)" />
  </ItemGroup>
</Project>
