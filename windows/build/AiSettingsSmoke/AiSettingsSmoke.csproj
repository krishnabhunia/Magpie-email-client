<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <StartupObject>AiSettingsSmoke.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Magpie.App/Magpie.App.csproj" />
    <Resource Include="../../Magpie.App/Assets/app.ico" Link="Assets/app.ico" />
    <Resource Include="../../Magpie.App/Assets/app-256.png" Link="Assets/app-256.png" />
    <Resource Include="../../Magpie.App/Assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
