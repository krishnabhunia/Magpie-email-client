<UserControl x:Class="Magpie.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Magpie.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CalendarViewModel}"
             Background="{DynamicResource Brush.Card.Background}">
    <UserControl.Resources>
        <!-- Design B2: an event block — soft fill in its calendar's colour, a solid bar at the left; unanswered invites dashed -->
        <ControlTemplate x:Key="EventBlock" TargetType="Button">
            <Grid Cursor="Hand" ToolTip="{Binding Tip}">
                <Rectangle RadiusX="5" RadiusY="5" Fill="{Binding Fill}" Stroke="{Binding Bar}" StrokeThickness="{Binding StrokeWidth}" StrokeDashArray="{Binding Dashes}" />
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="5,0,0,5" Background="{Binding Bar}" />
                <StackPanel Margin="8,2,4,2">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Short, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
            </Grid>
        </ControlTemplate>
        <!-- A small one-line chip (all-day row, month cells) -->
        <ControlTemplate x:Key="EventChip" TargetType="Button">
            <Grid Cursor="Hand" ToolTip="{Binding Tip}" Margin="0,1">
                <Rectangle RadiusX="4" RadiusY="4" Fill="{Binding Fill}" Stroke="{Binding Bar}" StrokeThickness="{Binding StrokeWidth}" StrokeDashArray="{Binding Dashes}" />
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="4,0,0,4" Background="{Binding Bar}" />
                <TextBlock Margin="7,1,4,1" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ─── Left rail: new event, mini month, calendars ─── -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Button Style="{StaticResource Button.Primary}" Content="New event" Command="{Binding NewEventCommand}" HorizontalAlignment="Stretch" ToolTip="Add an event (or double-click a time)" />

                    <DockPanel Margin="0,18,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="›" FontSize="16" Command="{Binding MiniNextCommand}" ToolTip="Next month" AutomationProperties.Name="Next month" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="‹" FontSize="16" Command="{Binding MiniPreviousCommand}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                        <TextBlock Text="{Binding MiniTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding WeekdayLetters}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding MiniDays}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MiniDay}">
                                <Button Command="{Binding DataContext.PickDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Height="26" Margin="1" CornerRadius="13" Background="Transparent">
                                                <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Body}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding InRange}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                    <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="CALENDARS" Style="{StaticResource Text.SectionCaps}" Margin="0,22,0,6" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding NoGoogleAccount, Converter={StaticResource BoolToVis}}"
                               Text="Add a Google account (Settings → Accounts) to see its calendar here." />
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarGroup}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Account}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Calendars}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarItem}">
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,3" ToolTip="Show or hide this calendar">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Colour}" Margin="2,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Button.Link}" Content="Check Google now" Command="{Binding CheckNowCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ─── Main area ─── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,16,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Button.Tab}" GroupName="CalMode" Content="Day" Command="{Binding SetModeCommand}" CommandParameter="Day"
                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Day}" />
                    <RadioButton Style="{StaticResource Button.Tab}" GroupName="CalMode" Content="Week" Command="{Binding SetModeCommand}" CommandParameter="Week"
                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Week}" />
                    <RadioButton Style="{StaticResource Button.Tab}" GroupName="CalMode" Content="Month" Command="{Binding SetModeCommand}" CommandParameter="Month"
                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Month}" />
                    <RadioButton Style="{StaticResource Button.Tab}" GroupName="CalMode" Content="Agenda" Command="{Binding SetModeCommand}" CommandParameter="Agenda"
                                 IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Agenda}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Content="Today" Command="{Binding TodayCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Icon}" Content="‹" FontSize="18" Command="{Binding PreviousCommand}" ToolTip="Back" AutomationProperties.Name="Back" />
                    <Button Style="{StaticResource Button.Icon}" Content="›" FontSize="18" Command="{Binding NextCommand}" ToolTip="Forward" AutomationProperties.Name="Forward" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Serif}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="{DynamicResource Brush.Warning.Subtle}" Padding="16,8" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Sign in again" Click="OnSignInAgain" Margin="12,0,0,0"
                            Visibility="{Binding ProblemNeedsSignIn, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Body}" />
                </DockPanel>
            </Border>

            <!-- Day / Week -->
            <Grid Grid.Row="2" Visibility="{Binding IsDayOrWeek, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.DayCount, RelativeSource={RelativeSource AncestorType=UserControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DayColumn}">
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Weekday}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <Border x:Name="Num" Width="30" Height="30" CornerRadius="15" Background="Transparent">
                                        <TextBlock x:Name="NumText" Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Num" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter TargetName="NumText" Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,14,4" Visibility="{Binding HasAllDay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="All day" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Right" Margin="0,3,8,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.DayCount, RelativeSource={RelativeSource AncestorType=UserControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DayColumn}">
                                <ItemsControl ItemsSource="{Binding AllDay}" Margin="2,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EventItem}">
                                            <Button Template="{StaticResource EventChip}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <ScrollViewer x:Name="DayScroll" Grid.Row="2" VerticalScrollBarVisibility="Visible" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                    <Grid Height="{Binding GridHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding Hours}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Height="48" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.DayCount, RelativeSource={RelativeSource AncestorType=UserControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DayColumn}">
                                    <Grid x:Name="DayCell" Background="Transparent" MouseLeftButtonDown="OnDayGridClick" ToolTip="Double-click to add an event at this time">
                                        <ItemsControl ItemsSource="{Binding DataContext.Hours, RelativeSource={RelativeSource AncestorType=UserControl}}" IsHitTestVisible="False" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><Border Height="48" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,0,0,1" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl x:Name="Blocks" ItemsSource="{Binding Timed}" Margin="3,0,4,0" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Setter Property="Height" Value="{Binding Height}" />
                                                    <Setter Property="Canvas.Left">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource Multiply}">
                                                                <Binding Path="LeftFraction" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Width">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource Multiply}" ConverterParameter="2">
                                                                <Binding Path="WidthFraction" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EventItem}">
                                                    <Button Template="{StaticResource EventBlock}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Canvas IsHitTestVisible="False" Visibility="{Binding ShowNow, Converter={StaticResource BoolToVis}}">
                                            <Border Canvas.Top="{Binding NowTop}" Height="2" Background="{DynamicResource Brush.Danger}"
                                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                                        </Canvas>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource Brush.Accent.Tint}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Month -->
            <Grid Grid.Row="2" Margin="12,0,12,12" Visibility="{Binding IsMonth, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Rows="1" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="Mon" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Tue" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Wed" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Thu" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Fri" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sat" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sun" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                </UniformGrid>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,1,0,0">
                    <ItemsControl ItemsSource="{Binding MonthCells}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="6" Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonthCell}">
                                <Border x:Name="Cell" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,1" Background="Transparent" Padding="4,3" ToolTip="Double-click to open this day">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <DockPanel>
                                        <TextBlock x:Name="Day" DockPanel.Dock="Top" Text="{Binding DayNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="2,0,0,2" />
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" FontSize="11" Foreground="{DynamicResource Brush.Accent.Text}" Margin="2,0,0,0"
                                                   Visibility="{Binding More, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EventItem}">
                                                    <Button Template="{StaticResource EventChip}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding InMonth}" Value="False">
                                        <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Accent.Tint}" />
                                        <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Agenda -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAgenda, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16,0,16,16">
                    <TextBlock Text="{Binding AgendaEmpty}" Style="{StaticResource Text.Caption}" Visibility="{Binding AgendaEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AgendaDay}">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock x:Name="Head" Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EventItem}">
                                                <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Padding="8,6" CornerRadius="6" Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="14" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                                    <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5" Background="{Binding Bar}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Text.Caption}" Visibility="{Binding Sub, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Row.Hover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Head" Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
