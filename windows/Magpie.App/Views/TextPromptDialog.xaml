<Window x:Class="Magpie.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Title="Magpie">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Serif}" FontSize="17" />
        <TextBlock x:Name="LabelText" Style="{StaticResource Text.Caption}" Margin="0,10,0,6" />
        <TextBox x:Name="Input" Style="{StaticResource TextBox.Field}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="OK" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
