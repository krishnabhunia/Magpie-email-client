<UserControl x:Class="Magpie.App.Views.AiReplyDraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Magpie.App.Services" svc:Typography.Role="aiStatus"
             Visibility="{Binding ShowReplyAi, Converter={StaticResource BoolToVis}}">
    <StackPanel Margin="0,0,0,16">
        <TextBlock Text="AI REPLY DRAFT" Style="{StaticResource Text.SectionCaps}" Foreground="{DynamicResource Brush.Ai}" Margin="0,0,0,6" />
        <TextBlock Text="Review before using. The recipients stay unchanged and your signature is kept once."
                   FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="Tone for this draft" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
        <ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyToneChoices}" SelectedItem="{Binding ReplyTone, Mode=TwoWay}" />
        <StackPanel Margin="0,8,0,0" Visibility="{Binding ReplyTone, Converter={StaticResource EqualsToVis}, ConverterParameter=Custom}">
            <TextBox svc:Typography.Role="fieldValue" Style="{StaticResource TextBox.Field}" Text="{Binding ReplyCustomTone, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" ToolTip="Custom tone for this draft" />
        </StackPanel>
        <TextBlock Text="Purpose for this draft" Style="{StaticResource Text.Caption}" Margin="0,12,0,5" />
        <ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyPurposeChoices}" SelectedItem="{Binding ReplyPurpose, Mode=TwoWay}" />
        <StackPanel Margin="0,8,0,0" Visibility="{Binding ReplyPurpose, Converter={StaticResource EqualsToVis}, ConverterParameter=Custom}">
            <TextBox svc:Typography.Role="fieldValue" Style="{StaticResource TextBox.Field}" Text="{Binding ReplyCustomPurpose, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" ToolTip="Custom purpose for this draft" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ai}" Content="Generate / Regenerate" Command="{Binding GenerateReplyDraftCommand}" MinHeight="30" Padding="10,4" />
            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CancelReplyDraftCommand}" Margin="6,0,0,0" Visibility="{Binding ReplyDraftBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="{Binding ReplyDraftBusy, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding ReplyDraftStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding ReplyDraftStatus, Converter={StaticResource BoolToVis}}" />
        <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0"
                Visibility="{Binding ReplyDraftPreview, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Generated draft" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ai}" Margin="0,0,0,7" />
                <TextBox Text="{Binding ReplyDraftPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="300" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="13" svc:Typography.Role="aiDraft" />
                <WrapPanel Margin="0,10,0,0">
                    <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ai}" Content="Use draft" Command="{Binding UseReplyDraftCommand}" IsEnabled="{Binding CanUseReplyDraft}" MinHeight="30" Padding="12,4" Margin="0,0,6,0" />
                    <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ghost}" Content="Discard" Command="{Binding DiscardReplyDraftCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding ReplyDraftError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" Visibility="{Binding ReplyDraftError, Converter={StaticResource BoolToVis}}" svc:Typography.Role="validation" />
        <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.AiChip}" Content="Set up AI provider" Command="{Binding OpenAiSettingsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding ReplyDraftNeedsSetup, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
