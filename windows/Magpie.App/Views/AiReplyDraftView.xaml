<UserControl x:Class="Magpie.App.Views.AiReplyDraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Magpie.App.ViewModels"
             xmlns:svc="clr-namespace:Magpie.App.Services" svc:Typography.Role="aiStatus"
             Visibility="{Binding ShowReplyAi, Converter={StaticResource BoolToVis}}">
    <!-- Design AW1: the AI draft panel under the editor — what the reply says (Q86), how it sounds + culture & etiquette (Q87),
         Forward note options (Q85), versions, Use draft / Rewrite / Discard. Choices here apply to this draft only. -->
    <Border Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="0,2,0,0">
        <DockPanel>
            <!-- Header: always visible; collapses the panel to one line -->
            <DockPanel DockPanel.Dock="Top" Margin="16,8,10,8">
                <Button DockPanel.Dock="Right" Command="{Binding ToggleReplyPanelCommand}" ToolTip="Show or hide the AI draft" FontSize="10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Setter Property="Content" Value="&#xE70D;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReplyPanelExpanded}" Value="True">
                                    <Setter Property="Content" Value="&#xE70E;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="Choices here apply to this draft only" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PanelTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" svc:Typography.Role="settingsSection" />
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding ReplyDraftBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Visibility="{Binding ReplyPanelExpanded, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16,0,16,14">

                    <!-- Q86 / Q85: what the reply says · why you're forwarding -->
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource Brush.Ai.Border}"
                            Visibility="{Binding ShowAnswerSection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AnswerNote}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AnswerTitle}" FontWeight="SemiBold" svc:Typography.Role="settingsSection" />
                            </DockPanel>
                            <Border Background="{DynamicResource Brush.Ai.Tint}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8"
                                    Visibility="{Binding HasAskLine, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ReplyAskLine}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding AnswerChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AiChoice}">
                                        <Button Style="{StaticResource Button.AiChoice}" Margin="0,0,6,6" svc:Typography.Role="toolbar"
                                                Command="{Binding DataContext.PickAnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Label}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ai}" Content="{Binding RewriteLabel}" Command="{Binding GenerateReplyDraftCommand}"
                                        MinHeight="34" Padding="14,4" Margin="8,0,0,0" VerticalAlignment="Stretch" svc:Typography.Role="toolbar" ToolTip="Rewrite the draft with these choices (Ctrl+Enter)" />
                                <TextBox x:Name="AnswerBox" Style="{StaticResource TextBox.Field}" svc:Typography.Role="fieldValue" Text="{Binding ReplyAnswer, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="False" TextWrapping="Wrap" MinHeight="34" MaxLength="500" VerticalContentAlignment="Center"
                                         Tag="In a few words, e.g. No, I won't be able to do it this week" ToolTip="What the reply should say, in a few words" />
                            </DockPanel>
                            <TextBlock Text="{Binding AnswerHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" svc:Typography.Role="helper" />
                        </StackPanel>
                    </Border>

                    <!-- Q85: Forward options -->
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource Brush.Ai.Border}"
                            Visibility="{Binding IsForward, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RecipientNote}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                <TextBlock Text="Recipient &amp; content" FontWeight="SemiBold" svc:Typography.Role="settingsSection" />
                            </DockPanel>
                            <CheckBox Content="Add a 2-line summary of the forwarded email" IsChecked="{Binding ForwardSummary, Mode=TwoWay}" Margin="0,0,0,6" />
                            <CheckBox Content="Mention the attachment (file name only)" IsChecked="{Binding ForwardMentionFiles, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Q87: how it sounds -->
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource Brush.Ai.Border}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="Tone and formality are separate" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="How it sounds" FontWeight="SemiBold" svc:Typography.Role="settingsSection" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ToneChips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AiChoice}">
                                        <Button Style="{StaticResource Button.AiChoice}" Margin="0,0,6,6" Content="{Binding Label}" svc:Typography.Role="toolbar"
                                                Command="{Binding DataContext.PickToneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Style="{StaticResource TextBox.Field}" svc:Typography.Role="fieldValue" Text="{Binding ReplyCustomTone, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,0,0,8"
                                     Tag="Describe the tone, e.g. calm and reassuring" Visibility="{Binding ReplyTone, Converter={StaticResource EqualsToVis}, ConverterParameter=Custom}" />
                            <TextBlock Text="Formality" Style="{StaticResource Text.Caption}" Margin="0,2,0,4" />
                            <ItemsControl ItemsSource="{Binding FormalityChips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AiChoice}">
                                        <Button Style="{StaticResource Button.AiSegment}" Content="{Binding Label}" svc:Typography.Role="toolbar"
                                                Command="{Binding DataContext.PickFormalityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,2,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="Like a letter" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <TextBlock Text="Like a chat" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Visibility="{Binding ShowPurpose, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Purpose" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyPurposeChoices}" SelectedItem="{Binding ReplyPurpose, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Length" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyLengthChoices}" SelectedItem="{Binding ReplyLength, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Language" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyLanguageChoices}" SelectedItem="{Binding ReplyLanguage, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBox Style="{StaticResource TextBox.Field}" svc:Typography.Role="fieldValue" Text="{Binding ReplyCustomPurpose, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Margin="0,8,0,0"
                                     Tag="Describe the purpose" Visibility="{Binding ReplyPurpose, Converter={StaticResource EqualsToVis}, ConverterParameter=Custom}" />
                        </StackPanel>
                    </Border>

                    <!-- Q87: culture & etiquette -->
                    <Expander Margin="0,0,0,10" IsExpanded="False" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" Padding="12,4,12,12">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Culture &amp; etiquette" FontWeight="SemiBold" svc:Typography.Role="settingsSection" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding CultureSummary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="English style" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyEnglishStyleChoices}" SelectedItem="{Binding ReplyEnglishStyle, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Business etiquette" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyEtiquetteChoices}" SelectedItem="{Binding ReplyEtiquette, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Directness" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyDirectnessChoices}" SelectedItem="{Binding ReplyDirectness, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="Greeting" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyGreetingChoices}" SelectedItem="{Binding ReplyGreeting, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Form of address" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyAddressChoices}" SelectedItem="{Binding ReplyAddress, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Text="Emoji" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /><ComboBox svc:Typography.Role="fieldValue" ItemsSource="{Binding ReplyEmojiChoices}" SelectedItem="{Binding ReplyEmoji, Mode=TwoWay}" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Auto follows the other person: if they wrote &quot;Hi Krishna&quot;, a Formal or less formal draft greets them the same way. The sign-off comes from your signature, so the draft never adds a second one."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" svc:Typography.Role="helper" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{Binding ReplyDraftStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ReplyDraftStatus, Converter={StaticResource BoolToVis}}" />

                    <!-- The draft with its versions -->
                    <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding ReplyDraftPreview, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="12,8,8,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" FontSize="10" Width="26" Height="26" MinHeight="26" Command="{Binding PreviousVersionCommand}" IsEnabled="{Binding CanPrevVersion}" ToolTip="Previous version" />
                                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="4,0" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" FontSize="10" Width="26" Height="26" MinHeight="26" Command="{Binding NextVersionCommand}" IsEnabled="{Binding CanNextVersion}" ToolTip="Next version" />
                                </StackPanel>
                                <TextBlock Text="{Binding UsedSummary}" FontSize="11.5" Foreground="{DynamicResource Brush.Ai.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="0,1,0,0" />
                            <TextBlock Text="{Binding LanguageNote}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="12,6,12,0" Visibility="{Binding LanguageNote, Converter={StaticResource BoolToVis}}" />
                            <TextBox Text="{Binding ReplyDraftPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" Padding="12,10" svc:Typography.Role="aiDraft" />
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Save these choices as my defaults" Command="{Binding SaveReplyDefaultsCommand}" VerticalAlignment="Center" FontSize="12" />
                        <WrapPanel>
                            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Primary}" Content="Use draft" Command="{Binding UseReplyDraftCommand}" IsEnabled="{Binding CanUseReplyDraft}" MinHeight="30" Padding="14,4" Margin="0,0,6,0" />
                            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Secondary}" Content="Rewrite" Command="{Binding GenerateReplyDraftCommand}" MinHeight="30" Padding="12,4" Margin="0,0,6,0" FontWeight="Normal" />
                            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ghost}" Content="Cancel" Command="{Binding CancelReplyDraftCommand}" Margin="0,0,6,0" Visibility="{Binding ReplyDraftBusy, Converter={StaticResource BoolToVis}}" />
                            <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.Ghost}" Content="Discard" Command="{Binding DiscardReplyDraftCommand}" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ReplyDraftError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" Visibility="{Binding ReplyDraftError, Converter={StaticResource BoolToVis}}" svc:Typography.Role="validation" />
                    <Button svc:Typography.Role="toolbar" Style="{StaticResource Button.AiChip}" Content="Set up AI provider" Command="{Binding OpenAiSettingsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding ReplyDraftNeedsSetup, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
