<Window x:Class="Magpie.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Magpie.App.ViewModels"
        xmlns:views="clr-namespace:Magpie.App.Views"
        xmlns:svc="clr-namespace:Magpie.App.Services"
        xmlns:models="clr-namespace:Magpie.Core.Models;assembly=Magpie.Core"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ComposeViewModel}"
        Title="{Binding WindowTitle}"
        Width="980" Height="720" MinWidth="640" MinHeight="460"
        Style="{StaticResource Window.Magpie}"
        Background="{DynamicResource Brush.Card.Background}"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MaxMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{DynamicResource Brush.TitleBar.Background}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" Height="30" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.TitleBar}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Maximize" Height="30" />
                    <Button Style="{StaticResource Button.TitleBar.Close}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Close" Height="30" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Magpie" svc:Typography.Role="appTitle" FontFamily="{StaticResource Font.Serif}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TitleBar.Text}" />
                    <TextBlock Text="{Binding WindowTitle}" FontSize="11.5" Foreground="{DynamicResource Brush.TitleBar.Muted}" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                    <Button x:Name="FocusModeButton" Style="{StaticResource Button.Ghost}" Content="Focus" Margin="16,0,0,0" Padding="9,3" ToolTip="Hide extra controls while writing" Click="OnToggleFocus" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="StudioModeButton" Style="{StaticResource Button.Ghost}" Content="Studio" Margin="4,0,0,0" Padding="9,3" ToolTip="Open attachments, review and delivery options" Click="OnToggleStudio" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ─── Message ─── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header fields -->
                <Grid Grid.Row="0" Margin="18,12,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="From" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" svc:Typography.Role="composeAddress" ItemsSource="{Binding Accounts}" SelectedItem="{Binding From, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,0,6" AutomationProperties.Name="Sender account" />

                    <TextBlock Grid.Row="1" Text="To" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Cc / Bcc" FontSize="12" Margin="10,0,0,0" Command="{Binding ShowCcCommand}"
                                Visibility="{Binding ShowCcBcc, Converter={StaticResource InvBoolToVis}}" />
                        <StackPanel>
                            <WrapPanel x:Name="ToChipPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="ToEditButton" Style="{StaticResource Button.Link}" Content="+ Add or edit recipients" Visibility="Collapsed" Click="OnEditRecipients" />
                                <Button Style="{StaticResource Button.Link}" Content="Contacts…" Tag="to" Click="OnPickContacts" Margin="8,0,0,0" ToolTip="Select one or more people or a saved contact group" />
                            </StackPanel>
                        <TextBox x:Name="ToBox" svc:Typography.Role="composeAddress" Style="{StaticResource TextBox.Field}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Tag="Name or address, separated by commas" AutomationProperties.Name="To recipients" AutomationProperties.HelpText="Type recipient addresses separated by commas" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop"
                                     TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Cc" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}">
                        <WrapPanel x:Name="CcChipPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="CcEditButton" Style="{StaticResource Button.Link}" Content="+ Add or edit Cc" Visibility="Collapsed" Click="OnEditRecipients" />
                            <Button Style="{StaticResource Button.Link}" Content="Contacts…" Tag="cc" Click="OnPickContacts" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBox x:Name="CcBox" svc:Typography.Role="composeAddress" Style="{StaticResource TextBox.Field}" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cc recipients" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop"
                                 TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Bcc" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}">
                        <WrapPanel x:Name="BccChipPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BccEditButton" Style="{StaticResource Button.Link}" Content="+ Add or edit Bcc" Visibility="Collapsed" Click="OnEditRecipients" />
                            <Button Style="{StaticResource Button.Link}" Content="Contacts…" Tag="bcc" Click="OnPickContacts" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBox x:Name="BccBox" svc:Typography.Role="composeAddress" Style="{StaticResource TextBox.Field}" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bcc recipients" AllowDrop="True" PreviewDragOver="OnRecipientDragOver" PreviewDrop="OnRecipientDrop"
                                 TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Subject" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" svc:Typography.Role="composeSubject" Style="{StaticResource TextBox.Field}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontWeight="Medium" AutomationProperties.Name="Email subject" />

                    <!-- Contact suggestions -->
                    <Popup x:Name="SuggestPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="320">
                            <ListBox x:Name="SuggestList" Style="{StaticResource ListBox.Flat}" MaxHeight="240" MouseUp="OnSuggestionClick" PreviewKeyDown="OnSuggestKey">
                                <ListBox.ItemTemplate>
                                    <!-- Design B4: saved contacts and people you wrote to ("Recent"), most written-to first -->
                                    <DataTemplate DataType="{x:Type models:ContactSuggestion}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Background="{DynamicResource Brush.Badge.Local.Background}" Visibility="{Binding Tag, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Badge.Local.Text}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Formatting -->
                <Border x:Name="FormattingToolbar" Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,1" Padding="14,3">
                    <WrapPanel Orientation="Horizontal" svc:Typography.Role="editorToolbar">
                        <Button Style="{StaticResource Button.Primary}" Content="Attach files…" Click="OnAttach" Margin="0,0,8,0" ToolTip="Attach one or more files (also available below Send)" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Recent ▾" Click="OnAttachRecent" Margin="0,0,8,0" ToolTip="Choose from files recently attached on this computer" />
                        <ComboBox x:Name="FontFamilyChoice" Width="118" Margin="0,0,5,0" SelectionChanged="OnFontChoice" ToolTip="Font family">
                            <ComboBoxItem Content="Arial" IsSelected="True" /><ComboBoxItem Content="Calibri" /><ComboBoxItem Content="Georgia" /><ComboBoxItem Content="Verdana" />
                        </ComboBox>
                        <ComboBox x:Name="FontSizeChoice" Width="60" Margin="0,0,6,0" SelectionChanged="OnFontSizeChoice" ToolTip="Font size">
                            <ComboBoxItem Content="12" /><ComboBoxItem Content="14" /><ComboBoxItem Content="16" /><ComboBoxItem Content="18" IsSelected="True" /><ComboBoxItem Content="20" /><ComboBoxItem Content="24" /><ComboBoxItem Content="32" />
                        </ComboBox>
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DD;" Tag="bold" Click="OnFormat" ToolTip="Bold (Ctrl+B)" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DB;" Tag="italic" Click="OnFormat" ToolTip="Italic (Ctrl+I)" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DC;" Tag="underline" Click="OnFormat" ToolTip="Underline (Ctrl+U)" />
                        <Button Style="{StaticResource Button.Icon}" Content="S̶" Tag="strikeThrough" Click="OnFormat" ToolTip="Strikethrough" />
                        <Button Style="{StaticResource Button.Icon}" Content="A" Tag="foreColor" Click="OnFormat" ToolTip="Text colour" />
                        <Button Style="{StaticResource Button.Icon}" Content="▣" Tag="hiliteColor" Click="OnFormat" ToolTip="Highlight selection" />
                        <Border Width="1" Margin="6,8" Background="{DynamicResource Brush.Divider}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8FD;" Tag="insertUnorderedList" Click="OnFormat" ToolTip="Bulleted list" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE9D5;" Tag="insertOrderedList" Click="OnFormat" ToolTip="Numbered list" />
                        <Button Style="{StaticResource Button.Icon}" Content="≡" Tag="justifyLeft" Click="OnFormat" ToolTip="Align left" />
                        <Button Style="{StaticResource Button.Icon}" Content="☷" Tag="justifyCenter" Click="OnFormat" ToolTip="Align centre" />
                        <Button Style="{StaticResource Button.Icon}" Content="⇥" Tag="indent" Click="OnFormat" ToolTip="Increase indent" />
                        <Button Style="{StaticResource Button.Icon}" Content="⇤" Tag="outdent" Click="OnFormat" ToolTip="Decrease indent" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE71B;" Click="OnLink" ToolTip="Insert or edit link (Ctrl+K)" />
                        <Button Style="{StaticResource Button.Icon}" Content="⌫" Click="OnRemoveLink" ToolTip="Remove link at the cursor" />
                        <Button Style="{StaticResource Button.Icon}" Content="▦" Click="OnInsertTable" ToolTip="Insert a table" />
                        <Button Style="{StaticResource Button.Icon}" Content="▧" Click="OnInsertImage" ToolTip="Insert an inline image" />
                        <Button Style="{StaticResource Button.Icon}" Content="↔" Click="OnResizeInlineImage" ToolTip="Resize a picture after clicking it in the message" />
                        <Button Style="{StaticResource Button.Icon}" Content="☺" Click="OnInsertEmoji" ToolTip="Insert an emoji" />
                        <Button Style="{StaticResource Button.Icon}" Content="↶" Tag="undo" Click="OnFormat" ToolTip="Undo (Ctrl+Z)" />
                        <Button Style="{StaticResource Button.Icon}" Content="↷" Tag="redo" Click="OnFormat" ToolTip="Redo (Ctrl+Y)" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Find" Click="OnFind" ToolTip="Find or replace message text (Ctrl+F / Ctrl+H)" />
                        <Button Style="{StaticResource Button.Secondary}" Content="More ▾" Click="OnMoreFormat" ToolTip="Heading, quote, superscript and more" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE894;" Tag="removeFormat" Click="OnFormat" ToolTip="Clear formatting" />
                    </WrapPanel>
                </Border>

                <!-- Editor -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="FindReplacePanel" Grid.Row="0" Visibility="Collapsed" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="16,7">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Find" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBox x:Name="FindTextBox" Width="200" MinHeight="28" TextChanged="OnFindTextChanged" KeyDown="OnFindInputKeyDown" AutomationProperties.Name="Text to find" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Next" Click="OnFindNext" Margin="6,0,0,0" ToolTip="Find next match" />
                                <CheckBox x:Name="FindMatchCase" Content="Match case" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock x:Name="FindReplaceStatus" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="✕" Click="OnCloseFind" Margin="10,0,0,0" ToolTip="Close find and replace" AutomationProperties.Name="Close find" />
                            </WrapPanel>
                            <WrapPanel x:Name="ReplaceControls" Visibility="Collapsed" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="With" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBox x:Name="ReplaceTextBox" Width="200" MinHeight="28" AutomationProperties.Name="Replacement text" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Replace" Click="OnReplaceOne" Margin="6,0,0,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Replace all" Click="OnReplaceAll" Margin="6,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="QuoteToggleButton" Grid.Row="1" Style="{StaticResource Button.Ghost}" Content="Show quoted message" Visibility="Collapsed" HorizontalAlignment="Left" Margin="18,3" FontSize="11.5" Click="OnToggleQuote" AutomationProperties.Name="Show or hide the original quoted message" ToolTip="Only folds the quote while writing; the complete original text remains in the outgoing reply" />
                    <wv2:WebView2 x:Name="Editor" Grid.Row="2" DefaultBackgroundColor="White" AutomationProperties.Name="Rich-text email message editor" />
                    <TextBox x:Name="PlainEditor" Grid.Row="2" svc:Typography.Role="composeBody" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Padding="18,12" AutomationProperties.Name="Plain-text email message editor"
                             VerticalScrollBarVisibility="Auto" FontFamily="Arial" FontSize="18" />
                </Grid>

                <!-- AI draft for Reply / Reply All / Forward (designs FR1 + AW1): under the editor -->
                <views:AiReplyDraftView x:Name="ReplyAi" Grid.Row="3" />

                <!-- Attachments -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Attachments}" Margin="16,6,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentItem}">
                            <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="6" Padding="10,4,4,4" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Width="38" Height="38" Stretch="UniformToFill" Margin="0,0,7,0" ToolTip="Image thumbnail" />
                                    <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Preview" FontSize="11" MinHeight="22" Padding="5,0" Margin="5,0,0,0" Click="OnPreviewAttachment" ToolTip="Preview images, PDFs, text, Word, Excel and PowerPoint files inside Magpie" AutomationProperties.Name="Preview attachment" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Compress" FontSize="11" MinHeight="22" Padding="5,0" Margin="4,0,0,0" Click="OnCompressAttachment" IsEnabled="{Binding CanCompress}" ToolTip="Save a reduced-size picture as a new file and attach it" AutomationProperties.Name="Compress image attachment" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Open" FontSize="11" MinHeight="22" Padding="5,0" Margin="5,0,0,0" Click="OnOpenAttachment" ToolTip="Open this file with its usual app" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Rename" FontSize="11" MinHeight="22" Padding="5,0" Margin="4,0,0,0" Click="OnRenameAttachment" ToolTip="Change the filename the recipient sees, not the local file" />
                                    <Button Style="{StaticResource Button.Icon}" Content="↑" Width="22" Height="22" MinHeight="22" Margin="3,0,0,0" ToolTip="Move attachment earlier"
                                            Command="{Binding DataContext.MoveAttachmentUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="↓" Width="22" Height="22" MinHeight="22" Margin="2,0,0,0" ToolTip="Move attachment later"
                                            Command="{Binding DataContext.MoveAttachmentDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="9" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="4" Text="{Binding AttachmentSummary}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,5" IsHitTestVisible="False" />

                <!-- Footer -->
                <Border Grid.Row="5" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" ToolTip="{Binding Status}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Send" Padding="22,6" Click="OnSend" IsEnabled="{Binding Sending, Converter={StaticResource InvBool}}" ToolTip="Send (Ctrl+Enter)" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Send later" Margin="8,0,0,0" FontWeight="Normal" Click="OnSendLater" />
                            <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" FontWeight="Normal" Click="OnAttach">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Attach" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Content="Recent ▾" Margin="3,0,0,0" Click="OnAttachRecent" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Templates" Margin="8,0,0,0" Click="OnTemplates" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Signatures ▾" Margin="4,0,0,0" Click="OnSignatures" ToolTip="Choose a saved signature for this message" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Save draft" Margin="2,0,0,0" Click="OnSaveDraft" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Save .eml" Margin="4,0,0,0" Click="OnSaveEml" ToolTip="Save a local copy of this message with attachments without sending" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Discard changes" Margin="4,0,0,0" Click="OnDiscardChanges" ToolTip="Discard edits made in this compose window; a previously saved draft is kept" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ─── AI rail (S5): only when Write draft or Rewrite is switched on ─── -->
            <Border Grid.Column="1" Width="46" Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowAiRail}" Value="True" />
                                    <Condition Binding="{Binding AiPanelOpen}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Width="32" Height="32" MinHeight="32" Padding="0" Command="{Binding ToggleAiPanelCommand}" ToolTip="Open the writing assistant" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="Assistant" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ─── Assistant panel (C2–C4) ─── -->
            <Border Grid.Column="1" Width="330" Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding AiPanelOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Command="{Binding ToggleAiPanelCommand}" ToolTip="Close assistant" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Assistant" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Ai}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProviderLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="16,0,16,8" TextTrimming="CharacterEllipsis" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,0,16,16">
                            <!-- Not configured -->
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" Visibility="{Binding AiNeedsSetup, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Connect an AI provider to use the assistant. Everything else in Magpie works without it." TextWrapping="Wrap" FontSize="12.5" />
                                    <Button Style="{StaticResource Button.Ai}" Content="Set up AI provider" HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="30" Padding="12,4" Command="{Binding OpenAiSettingsCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Write a draft -->
                            <StackPanel Visibility="{Binding ShowDraftAi, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="WRITE A DRAFT" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="72" VerticalContentAlignment="Top" Tag="e.g. Accept Friday, ask them to share the agenda" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ai}" Content="Write draft" MinHeight="32" Padding="14,4" Command="{Binding GenerateDraftCommand}" />
                                    <ComboBox ItemsSource="{Binding Tones}" SelectedItem="{Binding Tone, Mode=TwoWay}" Margin="0,0,8,0" ToolTip="Tone" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Rewrite selection -->
                            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowRewriteAi, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REWRITE SELECTION" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Text="Select text in your message, then pick a change."
                                           Visibility="{Binding SelectedText, Converter={StaticResource InvBoolToVis}}" />
                                <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                        Visibility="{Binding SelectedText, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedText}" FontSize="12" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Button.AiChip}" Content="Shorter" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Shorter" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Friendlier" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Friendlier" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="More formal" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="MoreFormal" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Fix grammar" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="FixGrammar" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Longer" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Longer" />
                                </WrapPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.AiChip}" Content="Go" Margin="6,0,0,0" Command="{Binding RewriteCommand}" CommandParameter="Custom" />
                                    <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding CustomRewrite, UpdateSourceTrigger=PropertyChanged}" Tag="Or say how to change it…" MinHeight="30" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Busy / error -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding AiBusy, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="70" Height="3" VerticalAlignment="Center" />
                                <TextBlock Text="Writing…" FontSize="12" Foreground="{DynamicResource Brush.Ai.Text}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding AiError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                                       Visibility="{Binding AiError, Converter={StaticResource BoolToVis}}" />

                            <!-- Preview card (C3): nothing goes into the message until you choose -->
                            <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                                    Visibility="{Binding AiPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="PREVIEW" Style="{StaticResource Text.SectionCaps}" Foreground="{DynamicResource Brush.Ai}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding AiPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                             Background="Transparent" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Body}" MaxHeight="320" VerticalScrollBarVisibility="Auto" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Button.Ai}" Content="Insert" MinHeight="30" Padding="12,3" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="insert"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=draft}" ToolTip="Insert at the cursor" />
                                        <Button Style="{StaticResource Button.AiChip}" Content="Replace my text" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="replace"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=draft}" ToolTip="Replace what you wrote (keeps the quoted message and signature)" />
                                        <Button Style="{StaticResource Button.Ai}" Content="Replace selection" MinHeight="30" Padding="12,3" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="selection"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=rewrite}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Discard" MinHeight="30" Padding="12,3" FontWeight="Normal" Margin="0,0,6,6" Command="{Binding DiscardPreviewCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Hybrid design A+B+C: the optional Studio panel keeps the existing AI panel intact. -->
            <Border x:Name="StudioPanel" Grid.Column="2" Width="310" Visibility="Collapsed" Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,0,0,0">
                <DockPanel Margin="14,12,14,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="×" Click="OnToggleStudio" ToolTip="Close Studio" />
                        <TextBlock Text="COMPOSE STUDIO" Style="{StaticResource Text.SectionCaps}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TabControl>
                        <TabItem Header="Files">
                            <StackPanel Margin="10">
                                <TextBlock Text="Attachments" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding AttachmentSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,12" />
                                <Border AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="8" Padding="16,22" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="📎 Drop files here" TextAlignment="Center" FontWeight="SemiBold" /><TextBlock Text="Or use the Attach button" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" /></StackPanel>
                                </Border>
                                <Button Style="{StaticResource Button.Primary}" Content="Browse files…" Click="OnAttach" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Paste files or screenshot…" Click="OnPasteAttachments" Margin="0,7,0,0" ToolTip="Attach files copied from File Explorer, or save and attach a screenshot from the clipboard" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Remove all attachments" Click="OnClearAttachments" Margin="0,7,0,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Insert picture…" Click="OnInsertImage" Margin="0,7,0,0" />
                                <TextBlock Text="Drop files into this window, or use Attach. Missing files and large messages are checked before Send." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,15,0,0" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Review">
                            <StackPanel Margin="10">
                                <TextBlock Text="Review before sending" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Checks: valid recipients, duplicates, missing or forgotten attachments, message size, empty subject and empty body." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,12" />
                                <Button Style="{StaticResource Button.Primary}" Content="Run safety review" Click="OnReview" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Options">
                            <StackPanel Margin="10">
                                <TextBlock Text="Message priority" FontWeight="SemiBold" />
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Priority, Mode=TwoWay}" Margin="0,6,0,14">
                                    <ComboBoxItem Content="Normal" /><ComboBoxItem Content="High" /><ComboBoxItem Content="Low" />
                                </ComboBox>
                                <TextBlock Text="Reply-To (optional)" FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding ReplyTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                                <CheckBox Content="Request read receipt" IsChecked="{Binding RequestReadReceipt, Mode=TwoWay}" />
                                <CheckBox Content="Warn before sending outside my email domain" IsChecked="{Binding WarnExternalRecipients, Mode=TwoWay}" Margin="0,9,0,0" ToolTip="Optional for this compose session; useful for work or confidential emails" />
                                <TextBlock Text="Receipts depend on recipients' mail apps and are not guaranteed." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Send later…" Click="OnSendLater" Margin="0,14,0,0" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
