<Window x:Class="Magpie.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Magpie.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ComposeViewModel}"
        Title="{Binding WindowTitle}"
        Width="980" Height="720" MinWidth="640" MinHeight="460"
        Style="{StaticResource Window.Magpie}"
        Background="{DynamicResource Brush.Card.Background}"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MaxMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{DynamicResource Brush.TitleBar.Background}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.TitleBar}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" Height="30" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.TitleBar}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Maximize" Height="30" />
                    <Button Style="{StaticResource Button.TitleBar.Close}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Close" Height="30" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Magpie" FontFamily="{StaticResource Font.Serif}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TitleBar.Text}" />
                    <TextBlock Text="{Binding WindowTitle}" FontSize="11.5" Foreground="{DynamicResource Brush.TitleBar.Muted}" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ─── Message ─── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header fields -->
                <Grid Grid.Row="0" Margin="18,12,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="From" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding From, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Text="To" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Cc / Bcc" FontSize="12" Margin="10,0,0,0" Command="{Binding ShowCcCommand}"
                                Visibility="{Binding ShowCcBcc, Converter={StaticResource InvBoolToVis}}" />
                        <TextBox x:Name="ToBox" Style="{StaticResource TextBox.Field}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Tag="Name or address, separated by commas"
                                 TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Cc" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CcBox" Style="{StaticResource TextBox.Field}" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                             Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />
                    <TextBlock Grid.Row="3" Text="Bcc" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="BccBox" Style="{StaticResource TextBox.Field}" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                             Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}" TextChanged="OnAddressChanged" PreviewKeyDown="OnAddressKey" LostKeyboardFocus="OnAddressLostFocus" />

                    <TextBlock Grid.Row="4" Text="Subject" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBox.Field}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontWeight="Medium" />

                    <!-- Contact suggestions -->
                    <Popup x:Name="SuggestPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="320">
                            <ListBox x:Name="SuggestList" Style="{StaticResource ListBox.Flat}" MaxHeight="240" MouseUp="OnSuggestionClick" PreviewKeyDown="OnSuggestKey">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Formatting -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,1" Padding="14,3">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DD;" Tag="bold" Click="OnFormat" ToolTip="Bold (Ctrl+B)" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DB;" Tag="italic" Click="OnFormat" ToolTip="Italic (Ctrl+I)" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8DC;" Tag="underline" Click="OnFormat" ToolTip="Underline (Ctrl+U)" />
                        <Border Width="1" Margin="6,8" Background="{DynamicResource Brush.Divider}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8FD;" Tag="insertUnorderedList" Click="OnFormat" ToolTip="Bulleted list" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE9D5;" Tag="insertOrderedList" Click="OnFormat" ToolTip="Numbered list" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE71B;" Click="OnLink" ToolTip="Insert link (Ctrl+K)" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE894;" Tag="removeFormat" Click="OnFormat" ToolTip="Clear formatting" />
                    </StackPanel>
                </Border>

                <!-- Editor -->
                <Grid Grid.Row="2">
                    <wv2:WebView2 x:Name="Editor" DefaultBackgroundColor="White" />
                    <TextBox x:Name="PlainEditor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Padding="18,12"
                             VerticalScrollBarVisibility="Auto" FontSize="14" />
                </Grid>

                <!-- Attachments -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Attachments}" Margin="16,6,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentItem}">
                            <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="6" Padding="10,4,4,4" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="9" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Send" Padding="22,6" Click="OnSend" IsEnabled="{Binding Sending, Converter={StaticResource InvBool}}" ToolTip="Send (Ctrl+Enter)" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Send later" Margin="8,0,0,0" FontWeight="Normal" Click="OnSendLater" />
                            <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" FontWeight="Normal" Click="OnAttach">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Attach" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Content="Templates" Margin="8,0,0,0" Click="OnTemplates" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Save draft" Margin="2,0,0,0" Click="OnSaveDraft" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ─── AI rail (S5): only when Write draft or Rewrite is switched on ─── -->
            <Border Grid.Column="1" Width="46" Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowAiRail}" Value="True" />
                                    <Condition Binding="{Binding AiPanelOpen}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Width="32" Height="32" MinHeight="32" Padding="0" Command="{Binding ToggleAiPanelCommand}" ToolTip="Open the writing assistant" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="Assistant" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ai}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ─── Assistant panel (C2–C4) ─── -->
            <Border Grid.Column="1" Width="330" Background="{DynamicResource Brush.Ai.Subtle}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding AiPanelOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Command="{Binding ToggleAiPanelCommand}" ToolTip="Close assistant" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Geo.Sparkle}" Stroke="{DynamicResource Brush.Ai}" StrokeThickness="1.1" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Assistant" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Ai}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProviderLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="16,0,16,8" TextTrimming="CharacterEllipsis" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,0,16,16">
                            <!-- Not configured -->
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" Visibility="{Binding AiNeedsSetup, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Connect an AI provider to use the assistant. Everything else in Magpie works without it." TextWrapping="Wrap" FontSize="12.5" />
                                    <Button Style="{StaticResource Button.Ai}" Content="Set up AI provider" HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="30" Padding="12,4" Command="{Binding OpenAiSettingsCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Write a draft -->
                            <StackPanel Visibility="{Binding ShowDraftAi, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="WRITE A DRAFT" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="72" VerticalContentAlignment="Top" Tag="e.g. Accept Friday, ask them to share the agenda" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ai}" Content="Write draft" MinHeight="32" Padding="14,4" Command="{Binding GenerateDraftCommand}" />
                                    <ComboBox ItemsSource="{Binding Tones}" SelectedItem="{Binding Tone, Mode=TwoWay}" Margin="0,0,8,0" ToolTip="Tone" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Rewrite selection -->
                            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowRewriteAi, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REWRITE SELECTION" Style="{StaticResource Text.SectionCaps}" Margin="0,0,0,6" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Text="Select text in your message, then pick a change."
                                           Visibility="{Binding SelectedText, Converter={StaticResource InvBoolToVis}}" />
                                <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                        Visibility="{Binding SelectedText, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedText}" FontSize="12" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Button.AiChip}" Content="Shorter" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Shorter" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Friendlier" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Friendlier" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="More formal" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="MoreFormal" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Fix grammar" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="FixGrammar" />
                                    <Button Style="{StaticResource Button.AiChip}" Content="Longer" Margin="0,0,6,6" Command="{Binding RewriteCommand}" CommandParameter="Longer" />
                                </WrapPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.AiChip}" Content="Go" Margin="6,0,0,0" Command="{Binding RewriteCommand}" CommandParameter="Custom" />
                                    <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding CustomRewrite, UpdateSourceTrigger=PropertyChanged}" Tag="Or say how to change it…" MinHeight="30" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Busy / error -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding AiBusy, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="70" Height="3" VerticalAlignment="Center" />
                                <TextBlock Text="Writing…" FontSize="12" Foreground="{DynamicResource Brush.Ai.Text}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding AiError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                                       Visibility="{Binding AiError, Converter={StaticResource BoolToVis}}" />

                            <!-- Preview card (C3): nothing goes into the message until you choose -->
                            <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Ai.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                                    Visibility="{Binding AiPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="PREVIEW" Style="{StaticResource Text.SectionCaps}" Foreground="{DynamicResource Brush.Ai}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding AiPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                             Background="Transparent" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Body}" MaxHeight="320" VerticalScrollBarVisibility="Auto" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Button.Ai}" Content="Insert" MinHeight="30" Padding="12,3" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="insert"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=draft}" ToolTip="Insert at the cursor" />
                                        <Button Style="{StaticResource Button.AiChip}" Content="Replace my text" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="replace"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=draft}" ToolTip="Replace what you wrote (keeps the quoted message and signature)" />
                                        <Button Style="{StaticResource Button.Ai}" Content="Replace selection" MinHeight="30" Padding="12,3" Margin="0,0,6,6" Command="{Binding AcceptPreviewCommand}" CommandParameter="selection"
                                                Visibility="{Binding PreviewKind, Converter={StaticResource EqualsToVis}, ConverterParameter=rewrite}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Discard" MinHeight="30" Padding="12,3" FontWeight="Normal" Margin="0,0,6,6" Command="{Binding DiscardPreviewCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
