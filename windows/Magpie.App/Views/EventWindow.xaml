<Window x:Class="Magpie.App.Views.EventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Title="Event">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Serif}" FontSize="17" TextWrapping="Wrap" />

        <!-- An invite from someone else: answer it here (design B2) -->
        <Border x:Name="InviteBar" Background="{DynamicResource Brush.Info.Subtle}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AcceptButton" Style="{StaticResource Button.Primary}" Content="Accept" Click="OnAccept" Margin="0,0,6,0" />
                    <Button x:Name="MaybeButton" Style="{StaticResource Button.Secondary}" Content="Maybe" Click="OnMaybe" Margin="0,0,6,0" />
                    <Button x:Name="DeclineButton" Style="{StaticResource Button.Secondary}" Content="Decline" Click="OnDecline" />
                </StackPanel>
                <TextBlock x:Name="InviteText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <TextBlock Text="Title" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
        <TextBox x:Name="TitleBox" Style="{StaticResource TextBox.Field}" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Starts" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBlock Grid.Column="4" Text="Ends" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <DatePicker x:Name="StartDay" Grid.Row="1" SelectedDateFormat="Short" SelectedDateChanged="OnStartDayChanged" />
            <ComboBox x:Name="StartTime" Grid.Row="1" Grid.Column="2" IsEditable="True" SelectionChanged="OnStartTimeChanged" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <DatePicker x:Name="EndDay" Grid.Row="1" Grid.Column="4" SelectedDateFormat="Short" />
            <ComboBox x:Name="EndTime" Grid.Row="1" Grid.Column="6" IsEditable="True" />
        </Grid>
        <CheckBox x:Name="AllDay" Content="All day" Margin="0,8,0,0" Checked="OnAllDayChanged" Unchecked="OnAllDayChanged" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Calendar" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                <ComboBox x:Name="CalendarBox" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Reminder" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                <ComboBox x:Name="ReminderBox" DisplayMemberPath="Label" />
            </StackPanel>
        </Grid>

        <TextBlock Text="People (addresses, separated by commas)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
        <TextBox x:Name="PeopleBox" Style="{StaticResource TextBox.Field}" />
        <TextBlock x:Name="Answers" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Text="Where" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
        <TextBox x:Name="WhereBox" Style="{StaticResource TextBox.Field}" />
        <DockPanel Margin="0,8,0,0">
            <Button x:Name="JoinButton" DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Join the video call" Click="OnJoin" Visibility="Collapsed" />
            <CheckBox x:Name="MeetBox" Content="Add a Google Meet video call" />
        </DockPanel>

        <StackPanel x:Name="RepeatPanel" Margin="0,12,0,0">
            <TextBlock Text="Repeat" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <ComboBox x:Name="RepeatBox" DisplayMemberPath="Label" />
        </StackPanel>

        <TextBlock Text="Notes" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
        <TextBox x:Name="NotesBox" Style="{StaticResource TextBox.Field}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="Error" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource Button.Danger}" Content="Delete" Click="OnDelete" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Style="{StaticResource Button.Secondary}" Content="Close" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" Content="Save" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
