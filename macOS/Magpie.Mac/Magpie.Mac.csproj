<Project Sdk="Microsoft.NET.Sdk">
  <!-- Magpie for Mac (plan PX1 part B): Avalonia 12 on .NET 10, Apple Silicon only. Build it from macOS/ (its
       global.json picks SDK 10; the repo root's picks SDK 8 for Windows): bash macOS/build/build.sh <version> -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Magpie</AssemblyName>
    <RootNamespace>Magpie.Mac</RootNamespace>
    <Product>Magpie</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Core is net8.0 and keeps its CA1416 (Windows-only DPAPI) note quiet; the Mac app never calls DPAPI. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Apple Silicon only (Krishna, 10 Oct 2026). -->
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPublishing)' == 'true'">osx-arm64</RuntimeIdentifier>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- WKWebView in Avalonia (MIT, Wieslaw Soltes): the reading pane and the compose editor. -->
    <PackageReference Include="NativeWebView" Version="12.0.4.9" />
    <PackageReference Include="NativeWebView.Platform.macOS" Version="12.0.4.9" />
    <!-- Avalonia / NativeWebView pull in 10.0.0, which has a vulnerability advisory (GHSA-846f-f764-76mx); the patched one wins. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\common\src\Magpie.Core\Magpie.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Magpie.Mac.Tests" />
  </ItemGroup>
</Project>
