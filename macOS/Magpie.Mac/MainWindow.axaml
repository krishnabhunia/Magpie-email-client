<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Magpie.Mac.ViewModels"
        x:Class="Magpie.Mac.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Magpie"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Magpie/Assets/magpie.png"
        Background="{DynamicResource Magpie.Pane}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">
  <Grid RowDefinitions="44,*,Auto">

    <!-- Top bar, in the title bar next to the traffic lights: app name, version (design V1), and at the top right the
         "Update to vx.y.z" button, shown only when GitHub has a newer version (design UB1). -->
    <Border Grid.Row="0" Name="TopBar" Background="{DynamicResource Magpie.TopBar}"
            BorderBrush="{DynamicResource Magpie.Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="84,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,12,0">
        <TextBlock Grid.Column="1" Text="Magpie" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Name="VersionLabel" Classes="muted" Text="{Binding VersionText}" FontSize="12"
                   Margin="8,1,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding VersionTip}" />
        <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding Updates.IsUpdateVisible, FallbackValue=False}">
          <Button Name="UpdateButton" Classes="update" Content="{Binding Updates.ButtonText}"
                  Command="{Binding Updates.UpdateNowCommand}" ToolTip.Tip="{Binding Updates.ButtonTip}" />
          <ProgressBar Height="3" MinHeight="3" Margin="10,2,10,0" Minimum="0" Maximum="1"
                       Value="{Binding Updates.Progress, FallbackValue=0}" IsVisible="{Binding Updates.ShowProgress, FallbackValue=False}" />
        </StackPanel>
        <Button Grid.Column="5" Classes="tool" Content="New message" Command="{Binding ComposeCommand}" Margin="0,0,6,0"
                ToolTip.Tip="New message (⌘N)" VerticalAlignment="Center" />
        <Button Grid.Column="6" Classes="tool" Content="Get mail" Command="{Binding SyncCommand}" Margin="0,0,6,0"
                ToolTip.Tip="Check every account for new mail (⇧⌘N)" VerticalAlignment="Center" />
        <Button Grid.Column="7" Classes="tool" Content="Settings" Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Settings (⌘,)" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="230,1,390,1,*">
      <!-- Sidebar: All inboxes, then each account and its folders with unread counts. -->
      <Border Grid.Column="0" Background="{DynamicResource Magpie.Sidebar}">
        <Grid RowDefinitions="*,Auto">
          <ListBox Name="SidebarList" ItemsSource="{Binding Sidebar}" SelectedItem="{Binding Current}"
                   Background="Transparent" Padding="6,6">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="26" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SidebarItem">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}">
                  <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{Binding AccountBrush}" IsVisible="{Binding IsHeader}" />
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" Classes="muted" Width="18" FontSize="12"
                             VerticalAlignment="Center" IsVisible="{Binding IsSelectable}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Classes.section="{Binding IsHeader}" Classes.unread="{Binding HasUnread}" />
                  <TextBlock Grid.Column="2" Text="{Binding UnreadText}" FontSize="12" Margin="6,0,2,0"
                             Foreground="{DynamicResource Magpie.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="1" Classes="link" Content="+ Add account" Command="{Binding AddAccountCommand}" Margin="10,6,10,10" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="{DynamicResource Magpie.Line}" ResizeDirection="Columns" />

      <!-- Message list with search (⌘F). -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding ListTitle}" Classes="heading" Margin="14,12,14,6" TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,0,12,8">
          <TextBox Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search (from:, to:, subject:, has:attachment …)" />
          <Button Grid.Column="1" Classes="link" Content="Clear" Command="{Binding ClearSearchCommand}" Margin="4,0,0,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <Panel Grid.Row="2">
          <ListBox Name="ThreadList" ItemsSource="{Binding Threads}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource Magpie.Line}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ThreadItem">
                <Grid ColumnDefinitions="14,*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{DynamicResource Magpie.Accent}" IsVisible="{Binding IsUnread}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" Classes.unread="{Binding IsUnread}" />
                  <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding AccountBrush}" IsVisible="{Binding ShowAccountDot}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="12" ToolTip.Tip="{Binding DateTip}" />
                  </StackPanel>
                  <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Classes.unread="{Binding IsUnread}" />
                    <TextBlock Grid.Column="1" Text="📎" FontSize="11" Margin="6,0,0,0" IsVisible="{Binding HasAttachments}" />
                    <TextBlock Grid.Column="2" Text="★" Foreground="{DynamicResource Magpie.Accent}" Margin="6,0,0,0" IsVisible="{Binding IsPinned}" ToolTip.Tip="Pinned" />
                    <TextBlock Grid.Column="3" Text="{Binding CountText}" Classes="muted" FontSize="11" Margin="6,0,0,0" />
                  </Grid>
                  <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Preview}" Classes="muted" FontSize="12.5"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsVisible="{Binding ShowEmpty}" />
        </Panel>
      </Grid>
      <GridSplitter Grid.Column="3" Background="{DynamicResource Magpie.Line}" ResizeDirection="Columns" />

      <!-- Reading pane: the conversation in the Mac's own web view (WKWebView), drawn by Core's HtmlRenderer. -->
      <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="18,12,18,10" BorderBrush="{DynamicResource Magpie.Line}" BorderThickness="0,0,0,1"
                IsVisible="{Binding Reader.HasThread}">
          <StackPanel Spacing="8">
            <SelectableTextBlock Text="{Binding Reader.Subject}" Classes="heading" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Reader.Meta}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="tool" Content="Reply" Command="{Binding Reader.ReplyCommand}" Margin="0,0,6,4" ToolTip.Tip="Reply (⌘R)" />
              <Button Classes="tool" Content="Reply all" Command="{Binding Reader.ReplyAllCommand}" Margin="0,0,6,4" ToolTip.Tip="Reply all (⇧⌘R)" />
              <Button Classes="tool" Content="Forward" Command="{Binding Reader.ForwardCommand}" Margin="0,0,14,4" ToolTip.Tip="Forward (⇧⌘F)" />
              <Button Classes="tool" Content="Archive" Command="{Binding Reader.ArchiveCommand}" Margin="0,0,6,4" ToolTip.Tip="Archive (⌃⌘A)" />
              <Button Classes="tool" Content="Delete" Command="{Binding Reader.DeleteCommand}" Margin="0,0,14,4" ToolTip.Tip="Move to Trash (⌘⌫, or ⌫ in the list)" />
              <Button Classes="tool" Content="{Binding Reader.ReadText}" Command="{Binding Reader.ToggleReadCommand}" Margin="0,0,6,4" ToolTip.Tip="⇧⌘U" />
              <Button Classes="tool" Content="{Binding Reader.PinText}" Command="{Binding Reader.TogglePinCommand}" Margin="0,0,6,4" ToolTip.Tip="⇧⌘L" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource Magpie.AccentSoft}" Padding="18,6" IsVisible="{Binding Reader.ShowImagesBar}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Reader.ImagesText}" VerticalAlignment="Center" FontSize="12.5" />
            <Button Classes="link" Content="Show pictures" Command="{Binding Reader.LoadImagesCommand}" />
            <Button Classes="link" Content="Always show from these senders" Command="{Binding Reader.TrustSendersCommand}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Name="ReaderHost" />
      </Grid>
    </Grid>

    <!-- "Sending “…” · 8 s  Undo" and other short notes. -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ToastItem">
          <Border Background="{DynamicResource Magpie.Toast}" CornerRadius="8" Padding="14,8" Margin="0,4,0,0" BoxShadow="0 4 14 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Magpie.ToastText}" VerticalAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
              <Button Classes="link" Content="Undo" IsVisible="{Binding CanUndo}" FontWeight="SemiBold"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UndoCommand}" CommandParameter="{Binding}" />
              <Button Classes="link" Content="Send now" IsVisible="{Binding CanUndo}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SendNowCommand}" CommandParameter="{Binding}" />
              <Button Classes="link" Content="✕" IsVisible="{Binding !CanUndo}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Magpie.Line}" BorderThickness="0,1,0,0" Padding="12,3"
            IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding SyncText}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
