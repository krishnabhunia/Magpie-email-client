<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Magpie.Core</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Magpie.Core.Tests" />
  </ItemGroup>
  <!-- Design IN1: the Info window's "What's implemented" and "What's new" tabs read these, built in at build time. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\docs\FEATURES.md" LogicalName="Magpie.FEATURES.md" Link="Info\FEATURES.md" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\CHANGELOG.md" LogicalName="Magpie.CHANGELOG.md" Link="Info\CHANGELOG.md" />
  </ItemGroup>
  <!-- Design SY1 / SA1: the sign-in apps built into each release, from the CI secrets of the same names (empty in a
       local build, then Settings -> Accounts -> Sign-in apps is needed as before). See Auth/BuiltInSignIn.cs. -->
  <ItemGroup>
    <AssemblyMetadata Include="MagpieGoogleClientId" Value="$(MAGPIE_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="MagpieGoogleClientSecret" Value="$(MAGPIE_GOOGLE_CLIENT_SECRET)" />
    <AssemblyMetadata Include="MagpieMicrosoftClientId" Value="$(MAGPIE_MICROSOFT_CLIENT_ID)" />
  </ItemGroup>
</Project>
