<Project>
  <PropertyGroup>
    <Version>18.2.0</Version>
    <AssemblyVersion>18.2.0.0</AssemblyVersion>
    <FileVersion>18.2.0.0</FileVersion>
    <Company>Krishna Bhunia</Company>
    <Product>Magpie</Product>
    <Copyright>© 2026 Krishna Bhunia</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Shown in Settings → About ("Released on dd-MMM-yyyy"); set with each release -->
    <ReleaseDate>2026-11-09</ReleaseDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
    <!-- Design IN1: this build's details for the Info window, set by CI (common/scripts/ci_version.py with its github-env option)
         through environment properties; empty in a local build, which the Info window then calls "Local build". -->
    <AssemblyMetadata Include="SourcePr" Value="$(MAGPIE_SOURCE_PR)" />
    <AssemblyMetadata Include="SourceCommit" Value="$(MAGPIE_SOURCE_COMMIT)" />
    <AssemblyMetadata Include="BuildTimeUtc" Value="$(MAGPIE_BUILD_TIME_UTC)" />
    <AssemblyMetadata Include="ReleaseTag" Value="$(MAGPIE_RELEASE_TAG)" />
  </ItemGroup>
</Project>
