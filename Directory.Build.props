<Project>
  <PropertyGroup>
    <Version>10.1.0</Version>
    <AssemblyVersion>10.1.0.0</AssemblyVersion>
    <FileVersion>10.1.0.0</FileVersion>
    <Company>Krishna Bhunia</Company>
    <Product>Magpie</Product>
    <Copyright>© 2026 Krishna Bhunia</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Shown in Settings → About ("Released on dd-MMM-yyyy"); set with each release -->
    <ReleaseDate>2026-10-30</ReleaseDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>
</Project>
